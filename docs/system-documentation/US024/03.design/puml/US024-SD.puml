@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as player

participant ":SimulationUI" as ui

activate player
player -> ui : starts simulation

create ":SimulationController" as ctrl
participant "simFile\n:SimulationFile" as simFile

activate ui
ui -> ctrl : create()

ui -> ctrl : asks to load simulation
activate ctrl

ctrl -> simFile : load()
activate simFile

alt file doesn't exist
    simFile --> simFile : creates new file
    simFile --> ctrl : returns failed
    ctrl --> ui : returns failed
    ui --> player : shows failed message
    ui --> ctrl : creates new simulation
    ctrl --> ctrl : creates new simulation
end

participant ":Repositories" as reps
participant "repositories\n:Repositories" as repo

simFile -> reps : getInstance()
activate reps

reps --> simFile : instance
deactivate reps

simFile --> simFile : copies simulation repository in file

simFile -> repo : loads simulation repository
activate repo

repo --> simFile : simulationRepository
deactivate repo

simFile --> simFile : copies station repository in file

simFile -> repo : loads station repository
activate repo

repo --> simFile : stationRepository
deactivate repo

simFile --> simFile : copies building repository in file

simFile -> repo : loads building repository
activate repo

repo --> simFile : buildingRepository
deactivate repo

simFile --> ctrl : confirms that simulation was loaded
deactivate simFile

ctrl --> ui : confirms that simulation was loaded
deactivate ctrl

ui --> player : shows success message on loading simulation
deactivate ui

@enduml