@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class User{
    username
    password
}

class Editor {
    + createMap(name: String, width: int, height: int)
}

class Scenario {
    map
    timePeriod
}

class TimePeriod {
    techRestrictions
    historicalEvents
}


class Map {
     name
     sizeX
     sizeY
     location
}

Editor --|> User

Editor o-- Scenario
Scenario *-- Map
TimePeriod --|> Scenario

@enduml