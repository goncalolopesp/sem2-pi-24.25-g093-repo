@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant "System" as System

activate Employee

Employee -> System : asks to create a new scenario
activate System
System --> Employee : requests scenario name
deactivate System

Employee -> System : types scenario name
activate System
System --> Employee : requests map selection
deactivate System

Employee -> System : selects map
activate System
System --> Employee : requests for time period, technological and historical restrictions
deactivate System

Employee -> System : selects technological restrictions, historical restrictions and invalid time period
activate System
System --> Employee : displays error message: "Error. Time Period must be within the interval\nof when the selected map gained access to trains and the most recent date."
System --> Employee : requests for valid time period
deactivate System

Employee -> System : selects valid time period
activate System
System --> Employee : displays operation success message: "Scenario created successfully."
deactivate System
@enduml