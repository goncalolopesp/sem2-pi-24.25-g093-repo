@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateScenarioUI" as CreateScenarioUI


activate Employee

Employee -> CreateScenarioUI : asks to create a new scenario
activate CreateScenarioUI

create ":CreateScenarioController" as CreateScenarioController
CreateScenarioUI -> CreateScenarioController : create
activate CreateScenarioController

participant ":Repositories" as Repositories
participant "repositories\n:Repositories" as Repo
participant "mapRepository\n:MapRepository" as mapRepository
participant "scenarioRepository\n:ScenarioRepository" as scenarioRepository

CreateScenarioController -> Repositories : getInstance()
activate Repositories

Repositories --> CreateScenarioController : repositories
deactivate Repositories

CreateScenarioController -> Repo : getMapRepository()
activate Repo

Repo -> mapRepository : getMapRepository()
activate mapRepository

mapRepository --> Repo : mapRepository
deactivate mapRepository

Repo --> CreateScenarioController : mapRepository
deactivate Repo

CreateScenarioController -> Repo : getScenarioRepository()
activate Repo

Repo -> scenarioRepository : getScenarioRepository()
activate scenarioRepository

scenarioRepository --> Repo : scenarioRepository
deactivate scenarioRepository

Repo --> CreateScenarioController : scenarioRepository
deactivate Repo
deactivate CreateScenarioController

CreateScenarioUI -> CreateScenarioUI: run()
CreateScenarioUI -> CreateScenarioUI : requestData()

    CreateScenarioUI --> Employee : requestSelectedMap()
    CreateScenarioUI --> Employee : requests the map selection
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types desired map's name
    activate CreateScenarioUI

    loop while selectedMap doesn't exist
        CreateScenarioUI -> CreateScenarioController : verifyIfMapExists(selectedMap)
        activate CreateScenarioController

        CreateScenarioController -> mapRepository  : verifyIfMapExists(selectedMap)
        activate mapRepository

        mapRepository -> mapRepository : verifyIfMapExists(selectedMap)
        mapRepository --> CreateScenarioController : return false
        deactivate mapRepository

        CreateScenarioController --> CreateScenarioUI : outputs "Map doesn't exist! Try again: "
        deactivate CreateScenarioController

        CreateScenarioUI --> Employee : requests the map selection
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types new desired map's name
        activate CreateScenarioUI
    end

    CreateScenarioUI --> Employee : requestScenarioName()
    CreateScenarioUI --> Employee : requests the scenario name
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types desired scenario name
    activate CreateScenarioUI

    loop while scenarioName isn't unique
        CreateScenarioUI -> CreateScenarioController : checkNameUniqueness(scenarioName)
        activate CreateScenarioController

        CreateScenarioController -> scenarioRepository  : checkNameUniqueness(scenarioName)
        activate scenarioRepository

        scenarioRepository -> scenarioRepository : checkNameUniqueness(scenarioName)
        scenarioRepository --> CreateScenarioController : return false
        deactivate scenarioRepository

        CreateScenarioController --> CreateScenarioUI : outputs "Name not unique. Try again: "
        deactivate CreateScenarioController

        CreateScenarioUI --> Employee : requests the scenario name
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types new desired scenario name
        activate CreateScenarioUI
    end

    CreateScenarioUI --> Employee : requestTimeRestrictions()
    CreateScenarioUI --> Employee : requests the starting year
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types the starting year
    activate CreateScenarioUI

    loop while startingYear is < 1804 or >= 2025
        alt Try block
            CreateScenarioUI -> CreateScenarioUI : parseInt(startingYear) and add to timePeriod array
        else Exception NumberFormatException e thrown
            CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
        end

        alt startingYear < 1804 or startingYear >= 2025
            CreateScenarioUI --> Employee : outputs "Starting Year must be equal or higher than 1804 and lower than 2025. Try again: "
        end

        CreateScenarioUI --> Employee : requests the starting year
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types the new starting year
        activate CreateScenarioUI
    end

    CreateScenarioUI --> Employee : requests the final year
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types the final year
    activate CreateScenarioUI

    loop while finalYear is <= startingYear or > 2025
        alt Try block
            CreateScenarioUI -> CreateScenarioUI : parseInt(finalYear) and add to timePeriod array
        else Exception NumberFormatException e thrown
            CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
        end

        alt finalYear <= startingYear or finalYear > 2025
            CreateScenarioUI --> Employee : outputs "Final Year must be higher than the Starting Year and equal or lower than 2025. Try again: "
        end

        CreateScenarioUI --> Employee : requests the final year
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types the new final year
        activate CreateScenarioUI
    end

    CreateScenarioUI --> Employee : requestPortBehavior()
        CreateScenarioUI --> Employee : requests the desired port
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types desired port
        activate CreateScenarioUI

        loop while port isn't valid
            alt Try block
                CreateScenarioUI -> CreateScenarioUI : parseInt(port)
            else Exception NumberFormatException e thrown
                CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
            end

            alt port < 1 or port > 2
                CreateScenarioUI --> Employee : outputs "Error: Chosen behavior must be included in the list. Try again: "
            end

            CreateScenarioUI --> Employee : requests new port
            deactivate CreateScenarioUI

            Employee -> CreateScenarioUI : types new port
            activate CreateScenarioUI
        end

    CreateScenarioUI --> Employee : requestTechnologicalRestrictions()
        CreateScenarioUI --> Employee : requests the available locomotive types
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types desired available locomotive types
        activate CreateScenarioUI

        loop while locomotive types aren't valid
            CreateScenarioUI -> CreateScenarioController : validateLocomotiveTypes(locomotiveTypes)
            activate CreateScenarioController

            CreateScenarioController -> scenarioRepository  : validateLocomotiveTypes(locomotiveTypes)
            activate scenarioRepository

            scenarioRepository -> scenarioRepository : validateLocomotiveTypes(locomotiveTypes)
            scenarioRepository --> CreateScenarioController : return false
            deactivate scenarioRepository

            CreateScenarioController --> CreateScenarioUI : outputs "Invalid input. Please enter only steam, diesel, and/or electric: "
            deactivate CreateScenarioController

            CreateScenarioUI --> Employee : requests the available locomotive types
            deactivate CreateScenarioUI

            Employee -> CreateScenarioUI : types desired available locomotive types
            activate CreateScenarioUI
        end

    CreateScenarioUI --> Employee : requestHistoricalRestrictions()
        CreateScenarioUI --> Employee : requests the historical restrictions
        deactivate CreateScenarioUI

        Employee -> CreateScenarioUI : types desired historical restrictions
        activate CreateScenarioUI

        loop while historical restrictions aren't valid
            CreateScenarioUI -> CreateScenarioController : validateHistoricalRestrictions(historicalRestrictions)
            activate CreateScenarioController

            CreateScenarioController -> scenarioRepository  : validateHistoricalRestrictions(historicalRestrictions)
            activate scenarioRepository

            scenarioRepository -> scenarioRepository : validateHistoricalRestrictions(historicalRestrictions)
            scenarioRepository --> CreateScenarioController : return false
            deactivate scenarioRepository

            CreateScenarioController --> CreateScenarioUI : outputs "Invalid input. Please enter only vaccination campaign and/or school program: "
            deactivate CreateScenarioController

            CreateScenarioUI --> Employee : requests the historical restrictions
            deactivate CreateScenarioUI

            Employee -> CreateScenarioUI : types desired historical restrictions
            activate CreateScenarioUI
        end

    CreateScenarioUI --> Employee : requestProductionRate()
            CreateScenarioUI --> Employee : requests the desired production rate
            deactivate CreateScenarioUI

            Employee -> CreateScenarioUI : types desired production rate
            activate CreateScenarioUI

            loop while rate isn't valid
                alt Try block
                    CreateScenarioUI -> CreateScenarioUI : parseDouble(rate)
                else Exception NumberFormatException e thrown
                    CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
                end

                alt rate < 0.5 or rate > 2
                    CreateScenarioUI --> Employee : outputs "Error: Production Rate must be between 0.5 and 2.0. Try again: "
                end

                CreateScenarioUI --> Employee : requests new rate
                deactivate CreateScenarioUI

                Employee -> CreateScenarioUI : types new rate
                activate CreateScenarioUI
            end

    CreateScenarioUI --> Employee : requestProfitMultiplier()
            CreateScenarioUI --> Employee : requests the desired profit multiplier
            deactivate CreateScenarioUI

            Employee -> CreateScenarioUI : types desired multiplier
            activate CreateScenarioUI

            loop while multiplier isn't valid
                alt Try block
                    CreateScenarioUI -> CreateScenarioUI : parseDouble(multiplier)
                else Exception NumberFormatException e thrown
                    CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
                end

                alt multiplier < 0.5 or multiplier > 2
                    CreateScenarioUI --> Employee : outputs "Error: Profit Multiplier must be between 0.5 and 2.0. Try again: "
                end

                CreateScenarioUI --> Employee : requests new multiplier
                deactivate CreateScenarioUI

                Employee -> CreateScenarioUI : types new multiplier
                activate CreateScenarioUI
            end


CreateScenarioUI -> CreateScenarioUI : submitData()
    CreateScenarioUI -> CreateScenarioController : createScenario(scenarioName, selectedMap, timeRestrictions, port, technologicalRestrictions, historicalRestrictions, rate, multiplier)
    activate CreateScenarioController

    create "scenario\n:Scenario" as Scenario

    CreateScenarioController -> Scenario : <<create>> new Scenario(scenarioName, selectedMap, timeRestrictions, port, technologicalRestrictions, historicalRestrictions, rate, multiplier)
    activate Scenario

    Scenario --> CreateScenarioController : Scenario
    deactivate Scenario

    CreateScenarioController -> scenarioRepository : add(Scenario)
    activate scenarioRepository

    scenarioRepository -> scenarioRepository : validateScenario(Scenario)
    deactivate scenarioRepository

    CreateScenarioController --> CreateScenarioUI : Scenario
    deactivate CreateScenarioController

    alt Scenario is present
        CreateScenarioUI --> Employee : outputs "Scenario successfully created!"
    else
        CreateScenarioUI --> Employee : outputs "Scenario not created!"
    end
deactivate CreateScenarioUI
@enduml