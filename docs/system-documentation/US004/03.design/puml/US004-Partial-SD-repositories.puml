@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant ":CreateScenarioUI" as CreateScenarioUI
activate CreateScenarioUI

create ":CreateScenarioController" as CreateScenarioController
CreateScenarioUI --> CreateScenarioController : create
activate CreateScenarioController

participant ":Repositories" as Repositories
participant "repositories\n:Repositories" as Repo

CreateScenarioController -> Repositories : getInstance()
activate Repositories

Repositories --> CreateScenarioController : repositories
deactivate Repositories

CreateScenarioController -> Repo : getMapRepository()
activate Repo

Repo -> mapRepository : getMapRepository()
activate mapRepository

mapRepository --> Repo : mapRepository
deactivate mapRepository

Repo --> CreateScenarioController : mapRepository
deactivate Repo

CreateScenarioController -> Repo : getScenarioRepository()
activate Repo

Repo -> scenarioRepository : getScenarioRepository()
activate scenarioRepository

scenarioRepository --> Repo : scenarioRepository
deactivate scenarioRepository

Repo --> CreateScenarioController : scenarioRepository
deactivate Repo
deactivate CreateScenarioController
@enduml