@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateScenarioUI" as CreateScenarioUI


activate Employee

Employee -> CreateScenarioUI : asks to create a new scenario
activate CreateScenarioUI

participant ":CreateScenarioController" as CreateScenarioController
participant ":Repositories" as Repositories
participant "repositories\n:Repositories" as Repo
participant "mapRepository\n:MapRepository" as mapRepository
participant "scenarioRepository\n:ScenarioRepository" as scenarioRepository

CreateScenarioUI --> CreateScenarioUI : requestData()

    CreateScenarioUI --> Employee : requestSelectedMap()
    CreateScenarioUI --> Employee : requests the map selection
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types desired map's name
    activate CreateScenarioUI

    loop while selectedMap doesn't exist
        CreateScenarioUI --> CreateScenarioController : verifyIfMapExists(selectedMap)
        activate CreateScenarioController

        CreateScenarioController --> mapRepository  : verifyIfMapExists(selectedMap)
        activate mapRepository

        mapRepository --> mapRepository : verifyIfMapExists(selectedMap)
        mapRepository --> CreateScenarioController : return false
        deactivate mapRepository

        CreateScenarioController --> CreateScenarioUI : outputs "Map doesn't exist! Try again: "
        deactivate CreateScenarioController

        CreateScenarioUI --> Employee : requests the map selection
        deactivate CreateScenarioUI

        Employee --> CreateScenarioUI : types new desired map's name
        activate CreateScenarioUI
    end

    CreateScenarioUI --> CreateScenarioController : verifyIfMapExists(selectedMap)
    activate CreateScenarioController

    CreateScenarioController --> mapRepository  : verifyIfMapExists(selectedMap)
    activate mapRepository

    mapRepository --> mapRepository : verifyIfMapExists(selectedMap)
    mapRepository --> CreateScenarioController : return true
    deactivate mapRepository

    CreateScenarioController --> CreateScenarioUI : returns selectedMap
    deactivate CreateScenarioController

    CreateScenarioUI --> Employee : requestScenarioName()
    CreateScenarioUI --> Employee : requests the scenario name
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types desired scenario name
    activate CreateScenarioUI

    loop while scenarioName isn't unique
        CreateScenarioUI --> CreateScenarioController : checkNameUniqueness(selectedMap)
        activate CreateScenarioController

        CreateScenarioController --> scenarioRepository  : checkNameUniqueness(selectedMap)
        activate scenarioRepository

        scenarioRepository --> scenarioRepository : checkNameUniqueness(selectedMap)
        scenarioRepository --> CreateScenarioController : return false
        deactivate scenarioRepository

        CreateScenarioController --> CreateScenarioUI : outputs "Name not unique. Try again: "
        deactivate CreateScenarioController

        CreateScenarioUI --> Employee : requests the scenario name
        deactivate CreateScenarioUI

        Employee --> CreateScenarioUI : types new desired scenario name
        activate CreateScenarioUI
    end

    CreateScenarioUI --> CreateScenarioController : checkNameUniqueness(selectedMap)
    activate CreateScenarioController

    CreateScenarioController --> scenarioRepository  : checkNameUniqueness(selectedMap)
    activate scenarioRepository

    scenarioRepository --> scenarioRepository : checkNameUniqueness(selectedMap)
    scenarioRepository --> CreateScenarioController : return true
    deactivate scenarioRepository

    CreateScenarioController --> CreateScenarioUI : returns trimmed scenario name
    deactivate CreateScenarioController

    CreateScenarioUI --> Employee : requestTimeRestrictions()
    CreateScenarioUI --> Employee : requests the starting year
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types the starting year
    activate CreateScenarioUI

    loop while startingYear is < 1804 or >= 2025
        alt Try block
            CreateScenarioUI --> CreateScenarioUI : parseInt(startingYear) and add to timePeriod array
        else Exception NumberFormatException e thrown
            CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
        end

        alt startingYear < 1804 or startingYear >= 2025
            CreateScenarioUI --> Employee : outputs "Starting Year must be equal or higher than 1804 and lower than 2025. Try again: "
        end

        CreateScenarioUI --> Employee : requests the starting year
        deactivate CreateScenarioUI

        Employee --> CreateScenarioUI : types the new starting year
        activate CreateScenarioUI
    end

    CreateScenarioUI --> Employee : requests the final year
    deactivate CreateScenarioUI

    Employee -> CreateScenarioUI : types the final year
    activate CreateScenarioUI

    loop while finalYear is <= startingYear or > 2025
        alt Try block
            CreateScenarioUI --> CreateScenarioUI : parseInt(finalYear) and add to timePeriod array
        else Exception NumberFormatException e thrown
            CreateScenarioUI --> Employee : outputs "Error: '" + input + "' is not a valid integer. Please enter a number. "
        end

        alt finalYear <= startingYear or finalYear > 2025
            CreateScenarioUI --> Employee : outputs "Final Year must be higher than the Starting Year and equal or lower than 2025. Try again: "
        end

        CreateScenarioUI --> Employee : requests the final year
        deactivate CreateScenarioUI

        Employee --> CreateScenarioUI : types the new final year
        activate CreateScenarioUI
    end
@enduml