@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

class Map {
     name
     sizeX
     sizeY
     location
}

class Scenario {
    map
    timePeriod
}

class TimePeriod {
    techRestrictions
    historicalEvents
}

class Simulator {
    status
    cargoGenerationRate
}

class Cargo{
    type
    status
}

class Station {
    name
    location
    type
    building
    cargo
}

Simulator *-- Station
Station o-- Cargo

TimePeriod --|> Scenario

Scenario *-- Map

Player "1" -- "1" Simulator
Simulator "1" -- "1" Map


@enduml