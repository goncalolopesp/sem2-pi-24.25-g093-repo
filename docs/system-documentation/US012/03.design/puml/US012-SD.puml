@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as player
activate player

participant ":SimulationUI" as ui

player -> ui : I want to create a simulator
activate ui

create ":SimulationController" as ctrl

ui --> ctrl : create()
activate ctrl

participant ":Repositories" as repositories
participant "repo\n:Repositories" as repo
participant "mapRepo\n:MapRepository" as mrepo
participant "scenarioRepo\n:ScenarioRepository" as srepo
participant "stationRepo\n:StationRepository" as stationrepo
participant "cityRepo\n:CityRepository" as crepo
participant "budgetRepo\n:BudgetRepository" as brepo

ctrl --> repositories : getInstance()
activate repositories

repositories --> ctrl : repositories
deactivate repositories

ctrl --> repo : getMapRepository()
activate repo

repo --> ctrl : mapRepo
deactivate repo

ctrl --> repo : getScenarioRepository()
activate repo

repo --> ctrl : scenarioRepo
deactivate repo

ctrl --> repo : getStationRepository()
activate repo

repo --> ctrl : stationRepo
deactivate repo

ctrl --> repo : getCityRepository()
activate repo

repo --> ctrl : cityRepo
deactivate repo
deactivate ctrl

ui --> ui : run()
ui --> ctrl : asks for selected map and scenario
activate ctrl

ctrl --> mrepo : asks for list of available maps
activate mrepo

alt if there are no maps available
    mrepo --> player : outputs "No maps available"
    mrepo --> ctrl : returns null
end

mrepo --> ctrl : returns list of available maps
deactivate mrepo

ctrl --> srepo : asks for list of available scenarios
activate srepo

alt if there are no scenarios available
    srepo --> player : outputs "No scenarios available"
    srepo --> ctrl : returns null
end

srepo --> ctrl : returns list of available scenarios
deactivate srepo

ctrl --> player : asks for map and scenario selection

loop while player chooses unavailable map/scenario
    player --> ctrl : selects map/scenario
    ctrl --> ctrl : checks if map/scenario exists
    ctrl --> player : asks for map/scenario selection
end

player --> ctrl : selects map and scenario
ctrl --> ctrl : checks if map and scenario exists
ctrl --> ui : returns map and scenario
deactivate ctrl

ui --> brepo : checks for player budget in present map and scenario
activate brepo

brepo --> ui : returns player budget
deactivate brepo

alt budget is null
    ui --> ui : creates new budget for selected map and scenario
    ui --> brepo : asks to save new budget
    activate brepo

    brepo --> brepo : saves new created budget
    deactivate brepo
end

ui --> ui : gets the time period from the scenario
ui --> ctrl : asks to execute the passage of time and generation of cargo
activate ctrl

par
    ctrl --> ctrl : executes the passage of time and generation of cargo in parallel with the rest of the simulation

    alt if player picks an option from the game menu
        ctrl --> ctrl : pauses both operations until action is over
    end
end

deactivate ctrl

ui --> player : displays the game information
ui --> player : displays the game menu and asks for player to select an option
deactivate ui

player --> ui : selects option
activate ui

ui --> ui : executes the UI responsible for selected option
ui --> player : displays updated game information
ui --> player : displays menu and asks for option again
deactivate ui
@enduml