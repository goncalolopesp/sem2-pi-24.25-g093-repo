@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant "SimulationUI" as ATUI

activate ATUI

create ":SimulationController" as ATC

participant ":Repositories" as REPO
participant "repositories\n:Repositories" as repo
participant "simulationRepository\n:SimulationRepository" as ATREPO

ATUI --> ATC : create()
deactivate ATUI

ATUI --> ATC : startSimulation(selectedMap)
activate ATUI
activate ATC

ATC --> REPO : getInstance()
activate REPO

REPO --> ATC : repositories
deactivate REPO

ATC --> repo : getSimulationRepository()
activate repo

repo --> ATC : SimulationRepository
deactivate repo

ATC --> ATREPO : startSimulation(selectedMap)
activate ATREPO

create "simulation\n:Simulation" as AT

ATREPO --> AT : create()
deactivate ATREPO
@enduml