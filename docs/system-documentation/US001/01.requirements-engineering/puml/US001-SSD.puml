@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee


    Employee -> System : asks to create a new map
        activate System
        System --> Employee : requests map size
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : requests map name
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : displays operation success
    deactivate System

@enduml