@startuml US021-SSD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor
participant ":System" as System
activate Editor
Editor -> System : createScenario(scenarioName, selectedMap, restrictions)
activate System
System -> System : validateScenario()
System -> System : addToRepository()
System -> System : saveToFile()
System --> Editor : displaySuccessMessage()
deactivate System

@enduml