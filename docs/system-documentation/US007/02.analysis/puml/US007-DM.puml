@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

class Station {
    name
    location
    type
    building
    cargo
}

class Building {
    name
    availability
    type
    upgrade
}

class Cargo{
    type
    status
}

Player *-- Station

Station *-- Building
Station o-- Cargo

@enduml