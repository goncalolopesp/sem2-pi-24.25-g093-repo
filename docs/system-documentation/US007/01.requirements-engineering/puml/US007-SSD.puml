@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "System" as System

activate Player

    Player -> System : I want to see all the stations
    activate System

    System --> Player : Displays all the stations
    deactivate System

    Player -> System : I want to see the details of a specific station
    activate System

    System --> Player : Displays the information about a station, including the buildings and the cargo
    deactivate System

@enduml