@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "Map Editor" as MapEditor

activate Player

    Player -> MapEditor : I want to see all the stations
    activate MapEditor

    MapEditor -> Player : Displays all the stations
    deactivate MapEditor

    Player -> MapEditor : I want to see the details of a specific station
    activate MapEditor

    MapEditor -> Player : Displays the information about a station, including the buildings and the cargo
    deactivate MapEditor

@enduml