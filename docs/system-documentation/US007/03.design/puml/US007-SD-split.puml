@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":ListStationsUI" as ListStationsUI

activate Player

Player -> ListStationsUI : asks to list the stations
activate ListStationsUI

create ":ListStationController" as ListStationController
ListStationsUI --> ListStationController : create()
activate ListStationController

ListStationController --> ListStationsUI : returns List<StationDTO>
deactivate ListStationController

alt stations list is empty
    ListStationsUI --> Player : outputs "No stations available."
    ListStationsUI --> ListStationsUI : return
else
    ListStationsUI --> Player : displays all the stations
    ListStationsUI --> Player : asks for station selection
end

deactivate ListStationsUI

Player -> ListStationsUI : selects a station
activate ListStationsUI

loop while station selection is invalid
    ListStationsUI --> ListStationsUI : validates station selection
    ListStationsUI --> Player : outputs "Invalid selection. Try again."
    ListStationsUI --> Player : asks for station selection
    deactivate ListStationsUI

    Player -> ListStationsUI : selects a station
    activate ListStationsUI
end

ListStationsUI --> ListStationsUI : validates station selection
ListStationsUI --> ListStationController : getStationDetails(stationDTO)
activate ListStationController

ListStationController --> ListStationsUI : returns StationDetailDTO
deactivate ListStationController

ListStationsUI --> Player : displays station details, buildings, and cargo demand/supply
deactivate ListStationsUI
deactivate Player

@enduml
