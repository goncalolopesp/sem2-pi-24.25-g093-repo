@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":ListStationsUI" as ListStationsUI

activate Player

Player -> ListStationsUI : asks to list the stations
activate ListStationsUI

ListStationsUI --> Player : displays all the stations
ListStationsUI --> Player : asks for station selection

deactivate ListStationsUI
Player -> ListStationsUI : selects a station
activate ListStationsUI

loop while station selection is invalid
    ListStationsUI --> ListStationsUI : validates station selection
    ListStationsUI --> Player : outputs "Invalid selection. Try again."
    ListStationsUI --> Player : asks for station selection
    deactivate ListStationsUI

    Player -> ListStationsUI : selects a station
    activate ListStationsUI
end

ListStationsUI --> ListStationsUI : validates station selection

@enduml
