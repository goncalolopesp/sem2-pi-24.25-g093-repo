@startuml US007-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'Domains
class User {
    - name : String
    - email : String
    - password : String
    - roleId : String
    - locomotives : List<Locomotive>
    - stations : List<Station>
    + getName() : String
    + getEmail() : String
    + getPassword() : String
    + getRoleId() : String
    + getLocomotives() : List<Locomotive>
    + getStations() : List<Station>
    + setName(String name) : void
    + setEmail(String email) : void
    + setPassword(String password) : void
    + setRoleId(String roleId) : void
    + setLocomotives(List<Locomotive> locomotives) : void
    + setStations(List<Station> stations) : void
}

class Building{
    - station : Station
    - buildingType : String
    - cargoType : String
    - cargoSupply : int
    - cargoDemand : int
    - owner : User
    + getStation() : Station
    + setStation(Station station) : void
    + getBuildingType() : String
    + setBuildingType(String buildingType) : void
    + getCargoType() : String
    + setCargoType(String cargoType) : void
    + getCargoSupply() : int
    + setCargoSupply(int cargoSupply) : void
    + getCargoDemand() : int
    + setCargoDemand(int cargoDemand) : void
    + getOwner() : User
    + setOwner(User owner) : void
}

class Station {
    - type : Type
    - name : String
    - mapName : String
    - ownerPlayer : String
    - price : int
    - capacity : int
    - capacityOwned : int
    - x : int
    - y : int
    - orientation : Orientation
    - buildings : List<Building>
    + Station(Type type, String name, String mapName, String ownerPlayer,
                         int price, int capacity, int capacityOwned, int x, int y, Orientation orientation)
    + getType() : Type
    + getName() : String
    + getMapName() : String
    + getOwnerPlayer() : String
    + getPrice() : int
    + getCapacity() : int
    + getCapacityOwned() : int
    + setCapacityOwned(int capacityOwned) : void
    + getX() : int
    + getY() : int
    + getOrientation() : Orientation
    + getBuildings() : List<Building>
    + setBuildings(List<Building> buildings) : void
    + addBuilding(Building building) : void
    + toString() : String
}

class CurrentUser{
    - session : CurrentUser
    - usr : Map<String, User>
    + getInstance() : CurrentUser
    + getUser() : User
    + setUser(User user) : void
    + doLogin(User user) : boolean
    + clear() : void
    + doLogout() : boolean
}

class Budget{
    - budget : int
    - map : Map
    - scenario : Scenario
    - user : User
    + getBudget() : int
    + setBudget(int budget) : void
    + addBudget(int budget) : void
    + subtractBudget(int budget) : void
    + getMap() : Map
    + setMap(Map map) : void
    + getScenario() : Scenario
    + setScenario(Scenario scenario) : void
    + getUser() : User
    + setUser(User user) : void
}

'DTOs

class StationDTO{
    - name : String
    - x : int
    - y : int
    + StationDTO(String name, int x, int y)
    + fromEntity(Station station) : StationDTO
    + getName() : String
    + getX() : int
    + getY() : int
}

class BuildingDTO{
    - buildingType : String
    - cargoType : String
    - cargoSupply : int
    - cargoDemand : int
    - stationName : String
    + BuildingDTO(String buildingType, String cargoType, int cargoSupply, int cargoDemand, String stationName)
    + fromEntity(Building building) : BuildingDTO
    + getBuildingType() : String
    + getCargoType() : String
    + getCargoSupply() : int
    + getCargoDemand() : int
    + getStationName() : String
    + toString() : String
}

class StationDetailDTO{
    - name : String
    - x : int
    - y : int
    - ownerPlayer : String
    - capacity : int
    - capacityOwned : int
    - buildings : List<BuildingDTO>
    + StationDetailDTO(String name, int x, int y, String ownerPlayer, int capacity, int capacityOwned, List<BuildingDTO> buildings)
    + fromEntity(Station station, List<Building> buildings) : StationDetailDTO
    + getName() : String
    + getX() : int
    + getY() : int
    + getOwnerPlayer() : String
    + getCapacity() : int
    + getCapacityOwned() : int
    + getBuildings() : List<BuildingDTO>
    + toString() : String
}

class DTOMapperStation{
    + toDTO(Station station) : StationDTO
    + toDTOList(List<Station> stations) : List<StationDTO>
    + toDetailDTO(Station station, List<Building> buildings) : StationDetailDTO
    + buildingsToDTOList(List<Building> buildings) : List<BuildingDTO>
}

'UI
class ListStationsUI {
    - listStationController : ListStationController
    + run() : void
    + getStations() : List<StationDTO>
    + displayStations(List<StationDTO> stations) : void
    + validateStationSelection(String selection) : boolean
    + getStationDetails(StationDTO station) : void
    + displayStationDetails(StationDetailDTO stationDetail) : void
}

'Interface
interface Runnable <<interface>>{
    + run() : void
}

'Controller
class ListStationController{
    - repositories : Repositories
    - stationRepository : StationRepository
    - buildingRepository : BuildingRepository
    + getStations() : List<StationDTO>
    + getStationDetails(StationDTO station) : StationDetailDTO
    + getBuildingsForStation(Station station) : List<BuildingDTO>
    + validateStationSelection(StationDTO station) : boolean
}

'Repository
class Repositories {
    - instance : Repositories
    - stationRepository : StationRepository
    - buildingRepository : BuildingRepository
    + getInstance() : Repositories
    + getStationRepository() : StationRepository
    + getBuildingRepository() : BuildingRepository
}

class BuildingRepository {
    - buildings : Set<Building>
    + BuildingRepository()
    + add(Building building) : boolean
    + validateBuilding(Building building) : boolean
    + getBuildings() : List<Building>
    + getBuildingsForStation(Station station) : List<Building>
    + getBuildingsByOwner(User owner) : List<Building>
}

class StationRepository {
    - stations : Set<Station>
    + addStation(Station station) : boolean
    + getStations() : List<Station>
    + getStationDetails(String stationName) : Station
    + getStationsByOwner(User owner) : List<Station>
    + removeStation(Station station) : boolean
    + validateStation(Station station) : boolean
}

'Connections
User ..> ListStationsUI

ListStationsUI ..|> Runnable
ListStationsUI --> ListStationController
ListStationsUI ..> StationDTO
ListStationsUI ..> StationDetailDTO

ListStationController --> Repositories
ListStationController ..> StationRepository
ListStationController ..> BuildingRepository
ListStationController ..> StationDTO
ListStationController ..> StationDetailDTO
ListStationController ..> DTOMapperStation

DTOMapperStation ..> Station : converts
DTOMapperStation ..> Building : converts
DTOMapperStation ..> StationDTO : creates
DTOMapperStation ..> StationDetailDTO : creates
DTOMapperStation ..> BuildingDTO : creates

StationDetailDTO --> "*" BuildingDTO

Repositories -> Repositories : instance
Repositories --> "1" StationRepository
Repositories --> "1" BuildingRepository

CurrentUser -> CurrentUser : instance
CurrentUser --> User : stores session

StationRepository "1" --> "*" Station
BuildingRepository "1" --> "*" Building

Budget --> User
Building --> User
Building --> Station
Station --> User
Station "1" --> "*" Building

@enduml