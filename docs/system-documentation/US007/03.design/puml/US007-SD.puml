@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":ListStationsUI" as ListStationsUI

activate Player

Player -> ListStationsUI : asks to list the stations
activate ListStationsUI

create ":ListStationController" as ListStationController

ListStationsUI --> ListStationController : create()
activate ListStationController

participant ":Repositories" as Repositories
participant "repositories\n:Repositories" as repo
participant "stationRepository\n:StationRepository" as srepo
participant "buildingRepository\n:BuildingRepository" as brepo
participant ":DTOMapperStation" as DTOMapper

ListStationController --> Repositories : getInstance()
activate Repositories

Repositories --> ListStationController : repositories
deactivate Repositories

ListStationController --> repo : getStationRepository()
activate repo

repo --> ListStationController : stationRepository
deactivate repo

ListStationController --> repo : getBuildingRepository()
activate repo

repo --> ListStationController : buildingRepository
deactivate repo

deactivate ListStationController

ListStationsUI --> ListStationController : getStations()
activate ListStationController

ListStationController --> srepo : getStations()
activate srepo

srepo --> ListStationController : returns List<Station>
deactivate srepo

ListStationController --> DTOMapper : toDTOList(stations)
activate DTOMapper

DTOMapper --> ListStationController : returns List<StationDTO>
deactivate DTOMapper

ListStationController --> ListStationsUI : returns List<StationDTO>
deactivate ListStationController

alt stations list is empty
    ListStationsUI --> Player : outputs "No stations available."
    ListStationsUI --> ListStationsUI : return
end

ListStationsUI --> Player : displays all the stations
ListStationsUI --> Player : asks for station selection
deactivate ListStationsUI

Player -> ListStationsUI : selects a station
activate ListStationsUI

loop while station selection is invalid
    ListStationsUI --> ListStationsUI : validates station selection
    ListStationsUI --> Player : outputs "Invalid selection. Try again."
    ListStationsUI --> Player : asks for station selection
    deactivate ListStationsUI

    Player -> ListStationsUI : selects a station
    activate ListStationsUI
end

ListStationsUI --> ListStationsUI : validates station selection
ListStationsUI --> ListStationController : getStationDetails(stationDTO)
activate ListStationController

ListStationController --> srepo : getStationDetails(stationDTO.getName())
activate srepo

srepo --> ListStationController : returns Station
deactivate srepo

ListStationController --> brepo : getBuildingsForStation(station)
activate brepo

brepo --> ListStationController : returns List<Building>
deactivate brepo

ListStationController --> DTOMapper : toDetailDTO(station, buildings)
activate DTOMapper

DTOMapper --> ListStationController : returns StationDetailDTO
deactivate DTOMapper

ListStationController --> ListStationsUI : returns StationDetailDTO
deactivate ListStationController

ListStationsUI --> Player : displays station details, buildings, and cargo demand/supply
deactivate ListStationsUI

deactivate Player

@enduml