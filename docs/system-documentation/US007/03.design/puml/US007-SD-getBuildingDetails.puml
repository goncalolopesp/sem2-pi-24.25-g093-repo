@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":ListStationsUI" as ListStationsUI
participant ":ListStationController" as ListStationController
participant "stationRepository\n:StationRepository" as srepo
participant "buildingRepository\n:BuildingRepository" as brepo
participant ":DTOMapperStation" as DTOMapper

Player -> ListStationsUI : selects a station
activate ListStationsUI

ListStationsUI --> ListStationsUI : validates station selection
ListStationsUI --> ListStationController : getStationDetails(stationDTO)
activate ListStationController

ListStationController --> srepo : getStationDetails(stationDTO.getName())
activate srepo
srepo --> ListStationController : returns Station
deactivate srepo

ListStationController --> brepo : getBuildingsForStation(station)
activate brepo
brepo --> ListStationController : returns List<Building>
deactivate brepo

ListStationController --> DTOMapper : toDetailDTO(station, buildings)
activate DTOMapper
DTOMapper --> ListStationController : returns StationDetailDTO
deactivate DTOMapper

ListStationController --> ListStationsUI : returns StationDetailDTO
deactivate ListStationController

ListStationsUI --> Player : displays station details, buildings, and cargo demand/supply
deactivate ListStationsUI

@enduml
