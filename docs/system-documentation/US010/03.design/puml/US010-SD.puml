@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":AssignTrainUI" as atui

activate Player

Player -> atui : asks to assign a selected train to a route
activate atui

create ":AssignTrainController" as atc

participant ":Repositories" as repositories
participant "repositories\n:Repositories" as repo
participant "stationRepository\n:StationRepository" as srepo
participant "locomotiveRepository\n:LocomotiveRepository" as lrepo
participant "trainRepository\n:TrainRepository" as trepo
participant "railwayLineRepository\n:RailwayLineRepository" as rlrepo
participant "routeRepository\n:RouteRepository" as rrepo
participant ":RailwayLine" as rl
participant ":Route" as route

atui -> atc : create()
activate atc

atc -> repositories : getInstance()
activate repositories

repositories --> atc : repositories
deactivate repositories

atc -> repo : getStationRepository()
activate repo

repo -> srepo : getStationRepository()
activate srepo

srepo --> repo : stationRepository
deactivate srepo

repo --> atc : stationRepository
deactivate repo

atc -> repo : getLocomotiveRepository()
activate repo

repo -> lrepo : getLocomotiveRepository()
activate lrepo

lrepo --> repo : locomotiveRepository
deactivate lrepo

repo --> atc : locomotiveRepository
deactivate repo

atc -> repo : getTrainRepository()
activate repo

repo -> trepo : getTrainRepository()
activate trepo

trepo --> repo : trainRepository
deactivate trepo

repo --> atc : trainRepository
deactivate repo

atc -> repo : getRailwayLineRepository()
activate repo

repo -> rlrepo : getRailwayLineRepository()
activate rlrepo

rlrepo --> repo : railwayLineRepository
deactivate rlrepo

repo --> atc : railwayLineRepository
deactivate repo

atc -> repo : getRouteRepository()
activate repo

repo -> rrepo : getRouteRepository()
activate rrepo

rrepo --> repo : routeRepository
deactivate rrepo

repo --> atc : routeRepository
deactivate repo
deactivate atc

atui -> atc : requests the list of stations owned by the player in the selected map
activate atc

atc -> srepo : requests the list of stations owned by the player in the selected map
activate srepo

srepo --> atc : returns list of stations owned by the player in the selected map
deactivate srepo

atc --> atui : returns list of stations owned by the player in the selected map
deactivate atc

alt stations owned by the player in the selected map is lower than 2
    atui --> Player : outputs "Error: You need at least 2 stations on this map to assign a train."
    atui -> atui : return
end

atui -> atc : requests the list of locomotives owned by the player
activate atc

atc -> lrepo : requests the list of locomotives owned by the player
activate lrepo

lrepo --> atc : returns the list of locomotives owned by the player
deactivate lrepo

atc --> atui : returns the list of locomotives owned by the player
deactivate atc

atui --> Player : displays the list of locomotives owned by the player

alt player doesn't own locomotives
    atui --> Player : outputs "Error: You need at least 1 locomotive to assign a train."
    atui -> atui : return
end

atui --> Player : requests locomotive selection
deactivate atui

Player -> atui : selects locomotive
activate atui

loop while locomotive selection is invalid
    atui -> atui : validates locomotive selection
    atui --> Player : outputs "Invalid selection. Try again."
end

atui --> Player : requests the route: start and end with respective cargo to be collected and pick-up modes
deactivate atui

Player -> atui : selects start and end of route with respective cargo to be collected and pick-up modes
activate atui

loop while invalid start and end of route
    atui -> atui : validates start and end of route
    atui --> Player : outputs "Invalid selection. Try again."
    atui --> Player : requests the route: start and end with respective cargo to be collected and pick-up modes
    deactivate atui

    Player -> atui : selects start and end of route with respective cargo to be collected and pick-up modes
    activate atui
end

atui --> Player : asks if Player wants to add optional intermediates with respective cargo to be collected and pick-up modes

alt if Player says yes

    atui --> Player : requests the optional intermediates with respective cargo to be collected and pick-up modes
    deactivate atui

    Player -> atui : selects optional intermediates with respective cargo to be collected and pick-up modes
    activate atui

    loop while invalid optional intermediates
        atui -> atui : validates optional intermediates
        atui --> Player : outputs "Invalid selection. Try again."
        atui --> Player : requests the optional intermediates with respective cargo to be collected and pick-up modes
        deactivate atui

        Player -> atui : selects optional intermediates with respective cargo to be collected and pick-up modes
        activate atui
    end
end

atui --> atc : assigns train to route
activate atc

atc -> rl** : <<create>> new RailwayLine(pointsOfRoute, type, distance, user, scenario, map)
activate rl

rl --> atc : RailwayLine
deactivate rl

atc -> rlrepo : save(RailwayLine)
activate rlrepo

rlrepo --> atc : (void)
deactivate rlrepo

atc -> route** : <<create>> new Route(pointsOfRoute, train, user, scenario, map)
activate route

route --> atc : Route
deactivate route

atc -> rrepo : save(Route)
activate rrepo

rrepo --> atc : (void)
deactivate rrepo

atc --> atui : (void)
deactivate atc

atui --> Player : outputs "Existing train assigned to route successfully!"
deactivate atui
@enduml
