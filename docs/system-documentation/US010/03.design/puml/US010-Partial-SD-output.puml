@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "AssignTrainUI" as atui
participant ":AssignTrainController" as atc

activate Player
activate atui
activate atc

atc --> atui : returns train route summary
deactivate atc

atui --> Player : outputs "Success: Train created with " + carriages.size() + " carriages and assigned to route with " + completeRoute.size() + " stations."
deactivate atui

@enduml