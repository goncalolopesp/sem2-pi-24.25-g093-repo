@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "AssignTrainUI" as atui

activate Player

Player -> atui : asks to assign a selected train to a route
activate atui

create ":AssignTrainController" as atc

atui --> atc : create()
atui --> atc : requests the list of stations owned by the player in the selected map
activate atc

ref over atc
    Gets list of stations owned by the player in the selected map
end ref

atc --> atui : returns list of stations owned by the player in the selected map
deactivate atc

alt stations owned by the player in the selected map is lower than 2
    atui --> Player : outputs "Error: You need at least 2 stations on this map to assign a train."
    atui --> atui : return
end

atui --> Player : gets the list of locomotives owned by the player

alt player doesn't own locomotives
    atui --> Player : outputs "Error: You need at least 1 locomotive to assign a train."
    atui --> atui : return
end

atui --> Player : requests locomotive selection
deactivate atui

Player -> atui : selects locomotive
activate atui

loop while locomotive selection is invalid
    atui --> atui : validates locomotive selection
    atui --> Player : outputs "Invalid selection. Try again."
    deactivate atui
end

Player -> atui : selects locomotive
activate atui

atui --> atui : validates locomotive
atui --> Player : requests the route: start and end
deactivate atui

Player -> atui : selects start and end of route
activate atui

loop while invalid start and end of route
    atui --> atui : validates start and end of route
    atui --> Player : outputs "Invalid selection. Try again."
    deactivate atui
end

Player -> atui : selects start and end of route
activate atui

atui --> atui : validates start and end of route
atui --> Player : asks if Player wants to add optional intermediates
deactivate atui

alt if Player says yes
    Player --> atui : accepts to add optional intermediates
    activate atui

    atui --> Player : requests the optional intermediates
    deactivate atui

    Player --> atui : selects optional intermediates
    activate atui

    loop while invalid optional intermediates
        atui --> atui : validates optional intermediates
        atui --> Player : outputs "Invalid selection. Try again."
        deactivate atui
    end

    Player --> atui : selects optional intermediates
    activate atui

    atui --> atui : validates optional intermediates
end

atui --> Player : requests the cargo type to be collected
deactivate atui

Player --> atui : selects cargo type
activate atui

loop while invalid cargo type
    atui --> atui : validates cargo type
    atui --> Player : outputs "Invalid selection. Try again."
    deactivate atui
end

Player --> atui : selects cargo type
activate atui

atui --> atui : validates cargo type
atui --> Player : requests the amount of carriages
deactivate atui

Player --> atui : selects amount of carriages
activate atui

loop while invalid amount of carriages
    atui --> atui : validates amount of carriages
    atui --> Player : outputs "Invalid number. Must be > 0."
    deactivate atui
end

Player --> atui : selects amount of carriages
activate atui

atui --> atui : validates amount of carriages
atui --> atui : new Train(locomotive, carriages, playerEmail)

create "train\n:Train" as train

atui --> train : create()
atui --> atc : add(train)
activate atc

ref over atc
    Adds train to repository
end ref

atc --> atui : returns train
deactivate atc

atui --> atui : creates route with the selected inputs
atui --> atc : assignTrainToRoute(train, route, cargo)
activate atc

atc --> atc : runs train route
atc --> atui : returns train route summary
deactivate atc

atui --> Player : outputs "Success: Train created with " + carriages.size() + " carriages and assigned to route with " + completeRoute.size() + " stations."
deactivate atui
@enduml
