@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "AssignTrainUI" as ATUI

activate Player

activate ATUI

create ":AssignTrainController" as ATC

participant "assignedTrainsRepository\n:AssignedTrainsRepository" as ATREPO

ATUI --> ATC : create()
deactivate ATUI

ATREPO --> ATC : ATData
activate ATUI
deactivate ATREPO

ATC --> ATUI : ATData
deactivate ATC

ATUI --> Player : displays operation success: "Train successfully assigned to route."
deactivate ATUI
@enduml