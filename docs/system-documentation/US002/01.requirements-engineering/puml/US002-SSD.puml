@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee


    Employee -> System :aks to add an industry
        activate System
        System --> Employee : shows list of maps
    deactivate System

    Employee -> System :  selects one map
    activate System

        System --> Employee : requests map coordinates
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : displays operation success
    deactivate System

@enduml