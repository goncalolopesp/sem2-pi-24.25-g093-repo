@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    username
    password
}

class Map {
    name
    sizeX
    sizeY
    location
}

class City {
    name
    Location
    numHouseBlocks
}

class Location {
    positionX
    positionY
}

class Station {
    name
    location
    type
    building
    cargo
}

Location --|> Map
Location --|> City
Location --|> Station
Player *-- Station
Map *-- Station
Map *-- City
Station "1" -- "1" City
@enduml
