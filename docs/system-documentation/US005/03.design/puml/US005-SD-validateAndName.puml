@startuml US005-SD-validateAndName
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
participant ":BuildStationController" as BuildController
participant "mapRepository\n::MapRepository" as MapRepo
participant "cityRepository\n::CityRepository" as CityRepo
participant "stationRepository\n::StationRepository" as StationRepo

activate BuildController

BuildController -> MapRepo : findMap(map)
activate MapRepo
MapRepo --> BuildController : map
deactivate MapRepo

BuildController -> CityRepo : findClosestCity(map, x, y)
activate CityRepo
CityRepo --> BuildController : city
deactivate CityRepo

BuildController -> StationRepo : verifyNoOverbuild(map, x, y)
activate StationRepo
StationRepo --> BuildController : noConflict
deactivate StationRepo

BuildController -> StationRepo : verifyBudget(type)
activate StationRepo
StationRepo --> BuildController : budgetOK
deactivate StationRepo

BuildController -> BuildController : generateName(City, type)
BuildController --> BuildController : stationName

@enduml
