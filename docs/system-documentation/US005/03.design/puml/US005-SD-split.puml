@startuml US005-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuildStationController" as BuildStationController
participant ":CreateStationController" as CreateStationController

activate Player

Player -> BuildStationController : select station type from dropdown
activate BuildStationController
BuildStationController -> BuildStationController : onStationTypeChanged()
BuildStationController -> BuildStationController : update cost and capacity labels
BuildStationController -> BuildStationController : check budget sufficiency
alt insufficient budget
    BuildStationController -> BuildStationController : showMessage("Insufficient funds!", ERROR)
    BuildStationController -> BuildStationController : disable build button
else budget sufficient
    BuildStationController -> BuildStationController : enable build button
    BuildStationController -> BuildStationController : show/hide orientation box
end
BuildStationController --> Player : UI updated with station info
deactivate BuildStationController

Player -> BuildStationController : enter X coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

Player -> BuildStationController : enter Y coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

opt station type is STATION
    Player -> BuildStationController : select orientation from dropdown
    activate BuildStationController
    BuildStationController --> Player : orientation selected
    deactivate BuildStationController
end

Player -> BuildStationController : click BUILD STATION button
activate BuildStationController
BuildStationController -> BuildStationController : handleBuildStation()
BuildStationController -> BuildStationController : validateInput()

BuildStationController -> CreateStationController : buildStation(type, map, scenario, x, y, orientation, budget)
activate CreateStationController

ref over CreateStationController
    Verifies coordinates, overbuild, and budget
    Gets closest city
    Creates station instance and saves to repository
end ref

CreateStationController --> BuildStationController : Error.OK/INVALID_COORDINATES/OVERBUILD/INSUFFICIENT_FUNDS
deactivate CreateStationController

alt result == OK
    BuildStationController -> CreateStationController : getLastCreatedStationDTO()
    activate CreateStationController
    ref over CreateStationController
        Retrieves last created station as DTO
    end ref
    CreateStationController --> BuildStationController : stationDTO
    deactivate CreateStationController

    BuildStationController -> BuildStationController : showMessage("Station built successfully", SUCCESS)
    BuildStationController -> BuildStationController : updateBudgetLabel()
    BuildStationController -> BuildStationController : clearForm()
    BuildStationController --> Player : display success message and updated budget
else result == INVALID_COORDINATES
    BuildStationController -> BuildStationController : showMessage("Coordinates out of bounds", ERROR)
    BuildStationController --> Player : display coordinate error
else result == OVERBUILD
    BuildStationController -> BuildStationController : showMessage("Cannot build on occupied cell", ERROR)
    BuildStationController --> Player : display overbuild error
else result == INSUFFICIENT_FUNDS
    BuildStationController -> BuildStationController : showMessage("Insufficient funds", ERROR)
    BuildStationController -> BuildStationController : updateBudgetLabel()
    BuildStationController --> Player : display budget error
end
deactivate BuildStationController
deactivate Player
@enduml