@startuml US005-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":BuildStationUI" as BuildUI
participant ":BuildStationController" as BuildController
participant ":MapRepository" as MapRepo
participant ":CityRepository" as CityRepo
participant ":StationRepository" as StationRepo

activate Player
Player -> BuildUI: openBuildStationForm()
activate BuildUI
BuildUI --> Player: displayForm()

Player -> BuildUI: enterData(map, type, x, y)
BuildUI -> BuildController: buildStation(map, type, x, y)
activate BuildController

BuildController -> MapRepo: findMap(map)
activate MapRepo
MapRepo --> BuildController: Map
deactivate MapRepo

BuildController -> CityRepo: findClosestCity(map, x, y)
activate CityRepo
CityRepo --> BuildController: City
deactivate CityRepo

BuildController -> StationRepo: createStation(name, type, x, y, map)
activate StationRepo
StationRepo --> BuildController: Station
deactivate StationRepo

BuildController --> BuildUI: showSuccess(Station)
deactivate BuildController

BuildUI --> Player: displaySuccess()
deactivate BuildUI
deactivate Player
@enduml
