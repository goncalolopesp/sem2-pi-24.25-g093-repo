@startuml US005-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":PlayerMenuController" as PlayerMenuController
participant ":BuildStationGUI" as BuildStationGUI
participant ":BuildStationController" as BuildStationController
participant ":CreateStationController" as CreateStationController
participant "repositories\n:Repositories" as Repositories
participant "stationRepository\n:StationRepository" as StationRepository
participant "cityRepository\n:CityRepository" as CityRepository

activate Player

Player -> PlayerMenuController : handleBuildStation()
activate PlayerMenuController
PlayerMenuController -> BuildStationGUI : launch(parentStage, map, scenario, budget)
activate BuildStationGUI

BuildStationGUI -> BuildStationGUI : load buildStation.fxml
create BuildStationController
BuildStationGUI -> BuildStationController : create()
activate BuildStationController

create CreateStationController
BuildStationController -> CreateStationController : create()

BuildStationController -> BuildStationController : initialize()
BuildStationController -> BuildStationController : setupComboBoxes()
BuildStationController -> BuildStationController : setupValidation()

BuildStationGUI -> BuildStationController : initData(map, scenario, budget, stage)
BuildStationController -> BuildStationController : updateBudgetLabel()

BuildStationGUI -> BuildStationGUI : showAndWait()
BuildStationGUI --> PlayerMenuController : modal dialog displayed
deactivate BuildStationGUI
deactivate PlayerMenuController

Player -> BuildStationController : select station type from dropdown
BuildStationController -> BuildStationController : onStationTypeChanged()
BuildStationController -> BuildStationController : update cost and capacity labels
BuildStationController -> BuildStationController : check budget sufficiency
alt insufficient budget
    BuildStationController -> BuildStationController : showMessage("Insufficient funds!", ERROR)
    BuildStationController -> BuildStationController : disable build button
else budget sufficient
    BuildStationController -> BuildStationController : enable build button
    BuildStationController -> BuildStationController : show/hide orientation box
end
BuildStationController --> Player : UI updated with station info
deactivate BuildStationController

Player -> BuildStationController : enter X coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

Player -> BuildStationController : enter Y coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

opt station type is STATION
    Player -> BuildStationController : select orientation from dropdown
    activate BuildStationController
    BuildStationController --> Player : orientation selected
    deactivate BuildStationController
end

Player -> BuildStationController : click BUILD STATION button
activate BuildStationController
BuildStationController -> BuildStationController : handleBuildStation()
BuildStationController -> BuildStationController : validateInput()

alt validation fails
    BuildStationController -> BuildStationController : showMessage(validation error, ERROR)
    BuildStationController --> Player : display validation error
else validation passes
    BuildStationController -> CreateStationController : buildStation(type, map, scenario, x, y, orientation, budget)
    activate CreateStationController

    CreateStationController -> Repositories : getInstance()
    activate Repositories
    Repositories --> CreateStationController : repositories
    deactivate Repositories

    CreateStationController -> StationRepository : verify coordinates and budget
    activate StationRepository
    StationRepository -> StationRepository : checkCoordinates(x, y, map)
    StationRepository -> StationRepository : checkOverbuild(x, y, map, scenario)
    StationRepository -> StationRepository : checkBudget(stationType, budget)
    StationRepository --> CreateStationController : validation result
    deactivate StationRepository

    alt validation successful
        CreateStationController -> CityRepository : getClosestCity(x, y, map)
        activate CityRepository
        CityRepository --> CreateStationController : closest city
        deactivate CityRepository

        CreateStationController -> StationRepository : createStation(type, x, y, orientation, map, scenario, budget)
        activate StationRepository
        create ":Station" as Station
        StationRepository -> Station : create(type, x, y, orientation, closestCity)
        StationRepository -> StationRepository : addStation(station)
        StationRepository -> StationRepository : deductBudget(cost)
        StationRepository --> CreateStationController : Error.OK
        deactivate StationRepository

        CreateStationController --> BuildStationController : Error.OK
    else validation failed
        CreateStationController --> BuildStationController : Error (INVALID_COORDINATES/OVERBUILD/INSUFFICIENT_FUNDS)
    end
    deactivate CreateStationController

    alt result == OK
        BuildStationController -> CreateStationController : getLastCreatedStationDTO()
        activate CreateStationController
        create ":StationDTO" as StationDTO
        CreateStationController -> StationDTO : fromEntity(lastCreatedStation)
        activate StationDTO
        StationDTO --> CreateStationController : stationDTO
        deactivate StationDTO
        CreateStationController --> BuildStationController : stationDTO
        deactivate CreateStationController

        BuildStationController -> BuildStationController : showMessage("Station built successfully", SUCCESS)
        BuildStationController -> BuildStationController : updateBudgetLabel()
        BuildStationController -> BuildStationController : clearForm()
        BuildStationController --> Player : display success message and updated budget
    else result == INVALID_COORDINATES
        BuildStationController -> BuildStationController : showMessage("Coordinates out of bounds", ERROR)
        BuildStationController --> Player : display coordinate error
    else result == OVERBUILD
        BuildStationController -> BuildStationController : showMessage("Cannot build on occupied cell", ERROR)
        BuildStationController --> Player : display overbuild error
    else result == INSUFFICIENT_FUNDS
        BuildStationController -> BuildStationController : showMessage("Insufficient funds", ERROR)
        BuildStationController -> BuildStationController : updateBudgetLabel()
        BuildStationController --> Player : display budget error
    end
end
deactivate BuildStationController

opt Player chooses to exit
    Player -> BuildStationController : click CANCEL button
    activate BuildStationController
    BuildStationController -> BuildStationController : handleCancel()
    BuildStationController -> BuildStationController : close stage
    BuildStationController --> Player : dialog closed
    deactivate BuildStationController
    destroy BuildStationController
end

@enduml