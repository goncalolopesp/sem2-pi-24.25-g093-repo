@startuml US005-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuildStationUI" as BuildStationUI


activate Player

Player -> BuildStationUI : buildStationRequest()
create ":BuildStaionController" as BuildStationController
activate BuildStationUI
BuildStationUI -> BuildStationController: <<create>>
participant "repositories\n:Repositories" as Repositories
participant "mapRepository\n:MapRepository" as MapRepository
participant "cityRepository\n:CityRepository" as CityRepository
participant "stationRepository\n:StationRepository" as StationRepository


BuildStationUI --> Player : request map selection
deactivate BuildStationUI
Player -> BuildStationUI : select map
activate BuildStationUI
BuildStationUI --> BuildStationUI : keepMap(map)


BuildStationUI -> BuildStationController : getRepositories()
activate BuildStationController
BuildStationController -> Repositories : getInstance()
activate Repositories
Repositories --> BuildStationController : repositories
deactivate Repositories
BuildStationController --> BuildStationUI : repositories

BuildStationUI --> Player : request station location
deactivate BuildStationUI
Player -> BuildStationUI : select location
activate BuildStationUI
BuildStationUI --> BuildStationUI : keepLocation(location)

BuildStationUI -> BuildStationController : checkOverbuild(location)
BuildStationController -> StationRepository : verifyNoOverbuild(location)
activate StationRepository
StationRepository --> BuildStationController : noConflict
deactivate StationRepository

BuildStationController --> BuildStationUI : proceed
deactivate BuildStationController
BuildStationUI --> Player : request station type (Depot/Station/Terminal)
deactivate BuildStationUI
Player -> BuildStationUI : select type
activate BuildStationUI
BuildStationUI --> BuildStationUI : keepType(type)

BuildStationUI -> BuildStationController : checkBudget(type)
activate BuildStationController
BuildStationController -> StationRepository : verifyBudget(type)

activate StationRepository
StationRepository --> BuildStationController : budgetOK
deactivate StationRepository
BuildStationController --> BuildStationUI : budgetOK



BuildStationUI -> MapRepository : getClosestCity(location)
activate MapRepository
MapRepository --> BuildStationUI : cityName
deactivate MapRepository
BuildStationUI --> StationRepository : proposeName(cityName, type)
activate StationRepository
StationRepository --> BuildStationUI : proposedName
deactivate StationRepository
BuildStationUI --> Player : display proposedName

alt type == "Depot" or type == "Terminal"
  BuildStationUI --> Player : request center (geometric)
  Player -> BuildStationUI : select center
  BuildStationUI --> BuildStationUI : keepCenter(center)
end

BuildStationUI --> BuildStationController : createStation(map, location, type, center)
deactivate BuildStationUI
BuildStationController -> StationRepository : createStation(map, location, type, center)
activate StationRepository
create ":station\n:Station" as Station

StationRepository -> Station: <<create>>

StationRepository --> StationRepository : saveStation()
StationRepository --> BuildStationController : stationData
deactivate StationRepository

BuildStationController --> BuildStationUI : stationData
deactivate BuildStationController

BuildStationUI --> Player : display "Station created successfully"
deactivate BuildStationUI
@enduml