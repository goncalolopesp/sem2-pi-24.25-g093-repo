@startuml US005-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuildStationUI" as BuildUI

activate Player
Player -> BuildUI : buildStationRequest()
activate BuildUI
BuildUI --> Player : displayBuildForm()

Player -> BuildUI : select map
BuildUI --> BuildUI : keepMap(map)

Player -> BuildUI : select location
BuildUI --> BuildUI : keepLocation(location)

Player -> BuildUI : select type
BuildUI --> BuildUI : keepType(type)

alt type == "Depot" or type == "Terminal"
  Player -> BuildUI : select center
  BuildUI --> BuildUI : keepCenter(center)
end

deactivate BuildUI
@enduml

