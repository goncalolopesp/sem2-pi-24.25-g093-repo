@startuml US005-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":PlayerMenuController" as PlayerMenuController
participant ":BuildStationGUI" as BuildStationGUI
participant ":BuildStationController" as BuildStationController

activate Player

Player -> PlayerMenuController : handleBuildStation()
activate PlayerMenuController
PlayerMenuController -> BuildStationGUI : launch(parentStage, map, scenario, budget)
activate BuildStationGUI

BuildStationGUI -> BuildStationGUI : load buildStation.fxml
create BuildStationController
BuildStationGUI -> BuildStationController : create()
activate BuildStationController

BuildStationController -> BuildStationController : initialize()
BuildStationController -> BuildStationController : setupComboBoxes()
BuildStationController -> BuildStationController : setupValidation()

BuildStationGUI -> BuildStationController : initData(map, scenario, budget, stage)
BuildStationController -> BuildStationController : updateBudgetLabel()

BuildStationGUI -> BuildStationGUI : showAndWait()
BuildStationGUI --> PlayerMenuController : modal dialog displayed
deactivate BuildStationGUI
deactivate PlayerMenuController

Player -> BuildStationController : select station type from dropdown
BuildStationController -> BuildStationController : onStationTypeChanged()
BuildStationController -> BuildStationController : update cost and capacity labels
BuildStationController -> BuildStationController : check budget sufficiency
alt insufficient budget
    BuildStationController -> BuildStationController : showMessage("Insufficient funds!", ERROR)
    BuildStationController -> BuildStationController : disable build button
else budget sufficient
    BuildStationController -> BuildStationController : enable build button
    BuildStationController -> BuildStationController : show/hide orientation box
end
BuildStationController --> Player : UI updated with station info
deactivate BuildStationController

Player -> BuildStationController : enter X coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

Player -> BuildStationController : enter Y coordinate
activate BuildStationController
BuildStationController -> BuildStationController : validate numeric input
BuildStationController --> Player : input validated
deactivate BuildStationController

opt station type is STATION
    Player -> BuildStationController : select orientation from dropdown
    activate BuildStationController
    BuildStationController --> Player : orientation selected
    deactivate BuildStationController
end

deactivate Player
@enduml