@startuml US005-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":BuildStationUI" as BuildUI

activate Player
Player -> BuildUI: openBuildStationForm()
activate BuildUI
BuildUI --> Player: displayForm()
Player -> BuildUI: enterData(mapId, type, x, y)
BuildUI --> BuildUI: validateAndStoreInput(mapId, type, x, y)
BuildUI --> BuildController: buildStation(mapId, type, x, y)
deactivate BuildUI
deactivate Player
@enduml
