@startuml US005-SD-createAndSuccess
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuildStationUI" as BuildUI

activate Player
Player -> BuildUI : buildStationRequest()
activate BuildUI
create ":CreateStationController" as BuildController
BuildUI -> BuildController : create()
activate BuildController
participant "repositories\n:Repositories" as Repositories
participant "stationRepository\n:StationRepository" as StationRepo

BuildController -> Repositories : getInstance()
activate Repositories
Repositories --> BuildController : repositories
deactivate Repositories
BuildController -> StationRepo : createStation(map,name, location, type, center)
activate StationRepo

create "station\n:Station" as Station
StationRepo -> Station         : create()
StationRepo -> StationRepo     : saveStation(Station)
StationRepo --> BuildController : stationData
deactivate StationRepo

BuildController --> BuildUI : stationData
deactivate BuildController
destroy BuildController

BuildUI --> Player : displaySuccess()
deactivate BuildUI
@enduml
