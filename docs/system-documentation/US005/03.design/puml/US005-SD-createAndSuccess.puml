@startuml US005-SD-createAndSuccess
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":BuildStationController" as BuildController
participant ":StationRepository" as StationRepo
participant ":BuildStationUI" as BuildUI
participant ":Station" as Station

BuildController -> StationRepo: createStation(name, type, x, y, map)
activate StationRepo
StationRepo -> Station: «create» Station(name, type, location, map)
activate Station
Station --> StationRepo: station
deactivate Station
deactivate StationRepo

BuildController --> BuildUI: showSuccess(station)
BuildUI --> Player: displaySuccess()
@enduml
