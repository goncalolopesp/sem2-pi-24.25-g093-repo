@startuml US006-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationGUI" as GUI
participant ":UpgradeStationFXController" as Controller
participant ":UpgradeStationController" as UpgradeController

activate Player

Player -> GUI : requests station upgrade window
activate GUI

create Controller
GUI -> Controller : create(selectedMap, selectedScenario, timePeriod, budget)
activate Controller

ref over Controller
    - initialize()
    - setupUI()
    - loadStations()
    - Get current user
    - Filter owned stations by user, scenario and map
end ref

alt no owned stations found
    Controller --> Player : display "You have no stations on this map."
else stations found
    Controller --> Player : display owned stations list
    GUI --> Player : display upgrade station window

    Player -> Controller : onStationSelected(MouseEvent)

    ref over Controller
        - showSelectedStation()
        - loadUpgradeOptions()
        - Filter available building types by year
        - Populate upgrade options
    end ref

    alt no upgrade options available
        Controller --> Player : display "No upgrade options available for this station."
    else upgrade options available
        Controller --> Player : show upgrade options

        Player -> Controller : onUpgradeOptionChanged()

        ref over Controller
            - updateCostAndCapacity()
            - Check budget sufficiency
            - Enable/disable upgrade button
        end ref

        Player -> Controller : handleUpgradeStation()

        Controller -> UpgradeController : upgradeStation(station, buildingType)
        activate UpgradeController

        ref over UpgradeController
            - Get repositories instance
            - Create Building object
            - Validate building in repository
            - Add building if valid
        end ref

        alt building created successfully
            UpgradeController --> Controller : building created

            ref over Controller
                - Subtract budget cost
                - Update budget display
                - Check mutual exclusivity
                - Load upgrade options
                - Reset UI selections
            end ref

            Controller --> Player : display "Building successfully created!"
        else building creation failed
            UpgradeController --> Controller : null
            Controller --> Player : display "Building creation failed. Please try again."
        end

        deactivate UpgradeController
    end
end


destroy Controller
deactivate Controller
deactivate GUI
deactivate Player

@enduml