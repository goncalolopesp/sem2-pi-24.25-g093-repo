@startuml US006-SD-applyAndSuccess
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":UpgradeStationUI" as UpgradeUI
participant ":UpgradeStationController" as Controller
participant ":StationRepository" as StationRepo

activate Player
activate UpgradeUI
UpgradeUI -> Controller: applyUpgrade(station, buildingType)
activate Controller

Controller -> StationRepo: upgradeStation(station, buildingType)
activate StationRepo
StationRepo --> Controller: updatedStation
deactivate StationRepo

Controller --> UpgradeUI: showSuccess()
deactivate Controller

UpgradeUI --> Player: displaySuccess()
deactivate UpgradeUI
@enduml
