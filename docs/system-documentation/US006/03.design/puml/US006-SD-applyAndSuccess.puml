@startuml US006-SD-applyAndSuccess
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationFXController" as Controller
participant ":UpgradeStationController" as UpgradeController
participant "repositories\n:Repositories" as Repo
participant "buildingRepository\n:BuildingRepository" as BuildingRepository
participant ":Budget" as Budget

activate Player
activate Controller

Player -> Controller : handleUpgradeStation()

Controller -> BuildingRepository : getBuildings()
activate BuildingRepository
BuildingRepository --> Controller : existing buildings for station
deactivate BuildingRepository

Controller -> UpgradeController : upgradeStation(station, buildingType)
activate UpgradeController

UpgradeController -> Repo : getInstance()
activate Repo
Repo --> UpgradeController : repositories
deactivate Repo

UpgradeController -> BuildingRepository : create Building(station, buildingType)
activate BuildingRepository
UpgradeController -> BuildingRepository : validateBuilding(building)

alt building is valid
    BuildingRepository -> BuildingRepository : add building to list
    BuildingRepository --> UpgradeController : building added successfully
    UpgradeController --> Controller : building created

    Controller -> Budget : subtractBudget(cost)
    activate Budget
    deactivate Budget

    Controller -> Controller : updateBudgetDisplay()
    Controller -> Controller : checkMutualExclusivity(existingBuildings, buildingType)

    alt mutually exclusive building exists
        Controller -> UpgradeController : getBuildingRepository()
        Controller -> BuildingRepository : remove(station, conflictingBuildingType)
    end

    Controller -> Controller : loadUpgradeOptions()
    Controller -> Controller : reset UI selections
    Controller --> Player : display "Building successfully created!"

else building validation failed
    BuildingRepository --> UpgradeController : building not added
    UpgradeController --> Controller : null
    Controller --> Player : display "Building creation failed. Please try again."
end

deactivate BuildingRepository
deactivate UpgradeController
deactivate Controller
deactivate GUI
deactivate Player

@enduml