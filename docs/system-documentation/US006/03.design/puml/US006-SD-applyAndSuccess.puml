@startuml US006-SD-applyAndSuccess
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationController" as UpgradeController
participant ":StationRepository" as StationRepo
participant "UpgradeStationUI" as UpgradeUI

UpgradeController --> StationRepo : Applies the building
StationRepo --> selectedStation : updateUpgrade(upgradeData)
StationRepo --> UpgradeController : upgradeConfirmation
UpgradeController --> UpgradeUI : Returns upgradeConfirmation
UpgradeUI --> Player : Shows success message "Upgrade applied successfully."

@enduml
