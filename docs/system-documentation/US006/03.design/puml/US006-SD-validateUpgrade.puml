@startuml US006-SD-validateUpgrade
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":UpgradeStationUI" as UpgradeUI
participant ":UpgradeStationController" as Controller
participant ":StationRepository" as StationRepo
participant ":BuildingRepository" as BuildingRepo

activate Player
Player -> UpgradeUI: chooseBuilding(buildingType)
activate UpgradeUI

UpgradeUI -> Controller: validateUpgrade(station, buildingType)
activate Controller

Controller -> StationRepo: findStation(station)
activate StationRepo
StationRepo --> Controller: Station
deactivate StationRepo

Controller -> BuildingRepo: findBuilding(buildingType)
activate BuildingRepo
BuildingRepo --> Controller: Building
deactivate BuildingRepo

Controller -> Controller: verifyTimeConstraints(Building, currentDate)
Controller -> Controller: verifyBudget(player, Building)

Controller --> UpgradeUI: displayValidationResult(ValidationResult)
deactivate Controller
UpgradeUI --> Player: showValidationResult(ValidationResult)
deactivate UpgradeUI
deactivate Player
@enduml
