@startuml US006-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationGUI" as GUI
participant ":UpgradeStationFXController" as Controller
participant ":UpgradeStationController" as UpgradeController
participant "repositories\n:Repositories" as Repo
participant "buildingRepository\n:BuildingRepository" as BuildingRepository
participant "stationRepository\n:StationRepository" as StationRepository
participant ":CurrentUser" as CurrentUser
participant ":Budget" as Budget

activate Player

Player -> GUI : requests station upgrade window
activate GUI

create Controller
GUI -> Controller : create(selectedMap, selectedScenario, timePeriod, budget)
activate Controller

Controller -> Controller : initialize()
Controller -> Controller : setupUI()
Controller -> Controller : loadStations()

Controller -> StationRepository : getStations()
activate StationRepository
StationRepository --> Controller : stations list
deactivate StationRepository

Controller -> CurrentUser : getInstance()
activate CurrentUser
CurrentUser --> Controller : currentUser
deactivate CurrentUser

Controller -> Controller : filter owned stations by user, scenario and map

alt no owned stations found
    Controller -> Controller : set messageLabel("You have no stations on this map.")
    Controller --> Player : display empty station list
else stations found
    Controller -> Controller : populate stationListView with formatted station names
    Controller --> Player : display owned stations list
    Controller -> Controller : updateBudgetDisplay()

    GUI -> GUI : show window
    GUI --> Player : display upgrade station window

    Player -> Controller : onStationSelected(MouseEvent)
    Controller -> Controller : showSelectedStation()
    Controller -> Controller : loadUpgradeOptions()

    Controller -> Controller : filter available building types by year and existing buildings
    Controller -> UpgradeController : verifyIfBuildingExists(station, buildingType)
    activate UpgradeController

    UpgradeController -> BuildingRepository : getBuildings()
    activate BuildingRepository
    BuildingRepository --> UpgradeController : buildings list
    deactivate BuildingRepository
    UpgradeController --> Controller : buildingExists
    deactivate UpgradeController

    Controller -> Controller : populate upgradeOptionComboBox with valid options
    Controller --> Player : display available building types with costs

    alt no upgrade options available
        Controller --> Player : display "No upgrade options available for this station."
    else upgrade options available
        Controller --> Player : show upgrade options and make visible upgradeOptionsBox

        Player -> Controller : onUpgradeOptionChanged()
        Controller -> Controller : updateCostAndCapacity()

        alt insufficient budget
            Controller --> Player : display cost in red and "Insufficient funds" message
            Controller -> Controller : disable upgradeButton
        else sufficient budget
            Controller --> Player : display cost in gold and enable upgradeButton
        end

        Player -> Controller : handleUpgradeStation()

        alt insufficient funds or invalid selection
            Controller --> Player : display error message
        else valid upgrade request
            Controller -> BuildingRepository : getBuildings()
            activate BuildingRepository
            BuildingRepository --> Controller : existing buildings for station
            deactivate BuildingRepository

            Controller -> UpgradeController : upgradeStation(station, buildingType)
            activate UpgradeController

            UpgradeController -> Repo : getInstance()
            activate Repo
            Repo --> UpgradeController : repositories
            deactivate Repo

            UpgradeController -> BuildingRepository : create Building(station, buildingType)
            activate BuildingRepository
            UpgradeController -> BuildingRepository : validateBuilding(building)

            alt building is valid
                BuildingRepository -> BuildingRepository : add building to list
                BuildingRepository --> UpgradeController : building added successfully
                UpgradeController --> Controller : building created

                Controller -> Budget : subtractBudget(cost)
                activate Budget
                deactivate Budget

                Controller -> Controller : updateBudgetDisplay()
                Controller -> Controller : checkMutualExclusivity(existingBuildings, buildingType)

                alt mutually exclusive building exists
                    Controller -> UpgradeController : getBuildingRepository()
                    Controller -> BuildingRepository : remove(station, conflictingBuildingType)
                end

                Controller -> Controller : loadUpgradeOptions()
                Controller -> Controller : reset UI selections
                Controller --> Player : display "Building successfully created!"

            else building validation failed
                BuildingRepository --> UpgradeController : building not added
                UpgradeController --> Controller : null
                Controller --> Player : display "Building creation failed. Please try again."
            end
            deactivate BuildingRepository
            deactivate UpgradeController
        end
    end
end


destroy Controller
deactivate GUI
deactivate Player

@enduml