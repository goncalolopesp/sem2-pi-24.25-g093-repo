@startuml US006-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationUI" as UpgradeStationUI

activate Player

Player -> UpgradeStationUI : requests station upgrade
activate UpgradeStationUI

create ":UpgradeStationController" as UpgradeStationController
UpgradeStationUI -> UpgradeStationController : «create»
activate UpgradeStationController

UpgradeStationUI --> Player : requests station and upgrade option
deactivate UpgradeStationUI

Player -> UpgradeStationUI : selects station and building
activate UpgradeStationUI

UpgradeStationUI --> UpgradeStationUI : keepSelection(station, buildingType)

participant "repositories\n:Repositories" as Repo
participant "buildingRepository\n:BuildingRepository" as buildingRepository
participant "stationRepository\n:StationRepository" as stationRepository

UpgradeStationUI -> UpgradeStationController : upgradeStation(station, buildingType)

UpgradeStationController -> Repo : getInstance()
activate Repo
Repo --> UpgradeStationController : repositories
deactivate Repo

UpgradeStationController -> buildingRepository : findBuilding(buildingType)
activate buildingRepository
buildingRepository --> UpgradeStationController : building

UpgradeStationController -> buildingRepository : checkAvailability(currentDate)
buildingRepository --> UpgradeStationController : availabilityOk
UpgradeStationController -> buildingRepository : checkBudget(buildingType)
buildingRepository --> UpgradeStationController: budgetOk
deactivate buildingRepository


UpgradeStationController -> stationRepository : findStation(station)
activate stationRepository
stationRepository --> UpgradeStationController : station

UpgradeStationController -> stationRepository : validateUpgrade(buildingType)
stationRepository --> UpgradeStationController : upgradeAllowed
UpgradeStationController -> stationRepository : applyUpgrade(station, buildingType)
stationRepository --> UpgradeStationController : upgradedStation
deactivate stationRepository

UpgradeStationController --> UpgradeStationUI : upgradedStation
deactivate UpgradeStationController
destroy UpgradeStationController
UpgradeStationUI --> Player : display "Upgrade applied successfully."
deactivate UpgradeStationUI
@enduml
