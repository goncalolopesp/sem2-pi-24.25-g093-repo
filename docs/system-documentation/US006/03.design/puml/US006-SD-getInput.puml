@startuml US006-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationGUI" as GUI
participant ":UpgradeStationFXController" as Controller
participant "stationRepository\n:StationRepository" as StationRepository
participant ":CurrentUser" as CurrentUser

activate Player

Player -> GUI : requests station upgrade window
activate GUI

create Controller
GUI -> Controller : create(selectedMap, selectedScenario, timePeriod, budget)
activate Controller

Controller -> Controller : initialize()
Controller -> Controller : setupUI()
Controller -> Controller : loadStations()

Controller -> StationRepository : getStations()
activate StationRepository
StationRepository --> Controller : stations list
deactivate StationRepository

Controller -> CurrentUser : getInstance()
activate CurrentUser
CurrentUser --> Controller : currentUser
deactivate CurrentUser

Controller -> Controller : filter owned stations by user, scenario and map

alt no owned stations found
    Controller -> Controller : set messageLabel("You have no stations on this map.")
    Controller --> Player : display empty station list
else stations found
    Controller -> Controller : populate stationListView with formatted station names
    Controller --> Player : display owned stations list
    Controller -> Controller : updateBudgetDisplay()

    GUI -> GUI : show window
    GUI --> Player : display upgrade station window

    Player -> Controller : onStationSelected(MouseEvent)
    Controller -> Controller : showSelectedStation()
    Controller -> Controller : loadUpgradeOptions()
end

deactivate Controller
deactivate GUI
deactivate Player

@enduml