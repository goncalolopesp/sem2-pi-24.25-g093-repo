@startuml US006-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeStationUI" as UpgradeStationUI

activate Player

Player -> UpgradeStationUI : openUpgradeStationForm()
activate UpgradeStationUI

UpgradeStationUI --> Player : displayStationList(listOfStations)

Player -> UpgradeStationUI : selectStation(station)
UpgradeStationUI --> UpgradeStationUI: keepStation(station)

UpgradeStationUI --> Player : displayBuildingOptions(buildingOptions)

Player -> UpgradeStationUI : chooseBuilding(buildingType)
UpgradeStationUI --> UpgradeStationUI: keepBuilding(buildingType)

@enduml
