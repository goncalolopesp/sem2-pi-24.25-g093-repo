@startuml US006-SD-getInput
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Player" as Player
participant ":UpgradeStationUI" as UpgradeUI

activate Player
Player -> UpgradeUI: openUpgradeStationForm()
activate UpgradeUI

UpgradeUI --> Player: displayStationList(listOfStations)

Player -> UpgradeUI: selectStation(station)

UpgradeUI --> Player: displayBuildingOptions(buildingOptions)

Player -> UpgradeUI: chooseBuilding(buildingType)

UpgradeUI -> UpgradeUI: validateAndStoreInput(station, buildingType)

deactivate UpgradeUI
deactivate Player
@enduml
