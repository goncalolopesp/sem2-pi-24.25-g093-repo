@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

'User Related

class User{
    username
    password
}

class Editor {
    + createMap(name: String, width: int, height: int)
}

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

'Map Related

class Map {
     name
     sizeX
     sizeY
     location
}

class Location {
    positionX
    positionY
}

class Station {
    name
    location
    type
    building
    cargo
}

class City {
    name
    Location
    numHouseBlocks
}

class Scenario {
    map
    timePeriod
}

class Route {
    stations
}

class HouseBlocks{

}

' Industry Related

class Industry {
    type
    Location
}

class Building {
    name
    availability
    type
    upgrade
}

class Cargo{
    type
    status
}

class Cost{

}

' Simulator Related

class TimePeriod {
    techRestrictions
    historicalEvents
}

class Simulator {
    status
    cargoGenerationRate
}

' Train Related

class Train{
    locomotives
    carriages
    cargoType
}

class Locomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
    typeOfFuel
    locomotiveType
}

class SteamLocomotive{

}

class DieselLocomotive{

}

class ElectricLocomotive{

}

class Carriage{
    typeOfCargo
}

' Travel Related

class Travel{

}

class Departure{

}

class Arrival{

}

class Time{

}


City o-- Location
Map o-- City
Map o-- Station
Scenario o-- Map
Train o-- Carriage
Train o-- Locomotive
Route o-- Travel
Route o-- Departure
Route o-- Arrival
Route o-- Time
Carriage o-- Cargo
Station o-- Cargo
Player o-- Locomotive
Player o-- Scenario
Player o-- Station
Player o-- Simulator
City o-- HouseBlocks
City o-- Industry
Station o-- Building
Locomotive o-- Cost
Station o-- Cost
Carriage o-- Cost
Industry o-- Location
Route o-- Train
Simulator o-- TimePeriod
Scenario o-- TimePeriod


TimePeriod -- Time
HouseBlocks -- Cargo
Editor -- Scenario
Editor -- Map
Player -- Train
Industry -- Cargo



SteamLocomotive *-- Locomotive
ElectricLocomotive *-- Locomotive
DieselLocomotive *-- Locomotive
Player *-- User
Editor *-- User





@enduml