@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Location {
    positionX
    positionY
}

class Map {
     name
     sizeX
     sizeY
     location
}

class Industry {
    type
    Location
}

class City {
    name
    Location
    numHouseBlocks
}

class Scenario {
    map
    timePeriod
}

class TimePeriod {
    techRestrictions
    historicalEvents
}

class Station {
    name
    location
    type
    building
    cargo
}

class Building {
    name
    availability
    type
    upgrade
}

class Cargo{
    type
    status
}

class Equipment {
    name
    mutuallyExclusivity
    replaces
}

class Train{
    locomotives
    carriages
    cargoType
}

class Route {
    stations
}

class Locomotive{
    locomotiveType
}

class SteamLocomotive{
    typeOfFuel
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class DieselLocomotive{
    typeOfFuel
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class ElectricLocomotive{
    typeOfFuel
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class Carriage{
    typeOfCargo
}

class Simulator {
    status
    cargoGenerationRate
}

class Editor {
    + createMap(name: String, width: int, height: int)
}

class ProductOwner {
}

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

Editor "1" -- "*" Scenario
Editor "1"--"*" Map

Map "1"--"*" Industry
Map "1"--"*" City

Station "*" -- "1" Map
Station "1" -- "1" City
Station "1" -- "*" Building
Station "*" -- "*" Cargo

Player "1"--"*" Train
Player "1"--"*" Station

Train "*"--"*" Locomotive
Train "*"--"*" Carriage
Train "1" -- "1" Route

Route "*" -- "*" Station

ProductOwner "1" -- "1" Simulator

Simulator "1" -- "*" Station

Scenario -- Locomotive
Scenario "1" -- "1" Map


TimePeriod --|> Scenario

Equipment --|> Building

Location --|> Map
Location --|> City
Location --|> Station
Location --|> Industry

SteamLocomotive --|> Locomotive
DieselLocomotive --|> Locomotive
ElectricLocomotive --|> Locomotive

@enduml