@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

'User Related

class User{
    username
    password
}

class Editor {
    + createMap(name: String, width: int, height: int)
}

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

'Map Related

class Map {
     name
     sizeX
     sizeY
     location
}

class Location {
    positionX
    positionY
}

class Station {
    name
    location
    type
    building
    cargo
}

class City {
    name
    Location
    numHouseBlocks
}

class Scenario {
    map
    timePeriod
}

class Route {
    stations
}

class HouseBlocks{

}

' Industry Related

class Industry {
    type
    Location
}

class Building {
    name
    availability
    type
    upgrade
}

class Cargo{
    type
    status
}

class Cost{

}

' Simulator Related

class TimePeriod {
    techRestrictions
    historicalEvents
}

class Simulator {
    status
    cargoGenerationRate
}

' Train Related

class Train{
    locomotives
    carriages
    cargoType
}

class Locomotive{
    typeOfFuel
    locomotiveType
}

class SteamLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class DieselLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class ElectricLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class Carriage{
    typeOfCargo
}

' Travel Related

class Travel{

}

class Departure{

}

class Arrival{

}

class Time{

}


Cost --|> Station
Cost --|> Building
Cost --|> Industry
Depot --|> Station
Station --|> Station
Terminal --|> Station
PrimarySectorIndustries --|> Industry
TransformingIndustries --|> Industry
MixedIndustries --|> Industry
TimePeriod --|> Scenario
Location --|> Map
Location --|> City
Location --|> Station
Location --|> Industry
SteamLocomotive --|> Locomotive
DieselLocomotive --|> Locomotive
ElectricLocomotive --|> Locomotive
Player --|> User
Editor --|> User

Travel o-- Cost
Travel o-- Departure
Travel o-- Arrival
Travel o-- Time
Travel o-- Train
Route o-- Station
Editor o-- Scenario
Station o-- Cargo
Train o-- Carriage

Route *-- Travel
Train *-- Locomotive
Editor *-- Map
City *-- HouseBlocks
Map *-- Industry
Map *-- City
Map *-- Station
Player *-- Station
Player *-- Train
Station *-- Building
Simulator *-- Station
Scenario *-- Map
Editor *-- City

Station "1" -- "1" City
Train "1" -- "1" Route
Player "1" -- "1" Simulator
Scenario "1"--"*" Locomotive

@enduml