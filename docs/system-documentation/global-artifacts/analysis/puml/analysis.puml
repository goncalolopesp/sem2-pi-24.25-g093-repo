@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    name
    sizeX
    sizeY
  }

  class City {
    name
    positionX
    positionY
    numHouseBlocks
  }

  class Industry {
    type
    positionX
    positionY
  }

  Map "1"--"*" City : contains
  Map "1"--"*" Industry : contains
}
@enduml