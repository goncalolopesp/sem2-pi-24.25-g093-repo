@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "System" as System

activate Player

    Player -> System : I want to buy a locomotive
    activate System

    System -> Player : Shows the available locomotives
    System -> Player : Asks the chosen locomotive

    Player -> System : Chooses a locomotive

    System -> Player : Shows successful message
    deactivate System

@enduml