@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
actor "Map Editor" as MapEditor

activate Player

    Player -> MapEditor : I want to buy a train
    activate MapEditor

    MapEditor -> Player : Shows the available trains
    MapEditor -> Player : Asks the chosen train

    Player -> MapEditor : Chooses a train

    MapEditor -> Player : Shows successful message
    deactivate MapEditor

@enduml