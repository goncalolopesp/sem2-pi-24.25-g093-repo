@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "System" as System

activate Player

    Player -> System : I want to buy a locomotive
    activate System

    System --> Player : Shows the available locomotives
    System --> Player : Asks the chosen locomotive
    deactivate System

    Player -> System : Chooses a locomotive ("Not enough budget")
    activate System

    System --> Player : Shows error message "Unable to buy: Not enough money"
    deactivate System

@enduml