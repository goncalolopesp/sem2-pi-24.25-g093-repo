@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuyLocomotiveUI" as BuyLocomotiveUI

activate Player

Player -> BuyLocomotiveUI : asks to buy a locomotive
activate BuyLocomotiveUI

create ":BuyLocomotiveController" as BuyLocomotiveController

participant ":Repositories" as Repositories
participant "repositories\n:Repositories" as repo
participant "locomotiveRepository\n:LocomotiveRepository" as lrepo
participant "scenarioRepository\n:ScenarioRepository" as srepo
participant "budgetRepository\n:BudgetRepository" as brepo
participant ":DTOMapperLocomotive" as DTOMapper

BuyLocomotiveUI --> BuyLocomotiveController : create()
activate BuyLocomotiveController

BuyLocomotiveController --> Repositories : getInstance()
activate Repositories

Repositories --> BuyLocomotiveController : repositories
deactivate Repositories

BuyLocomotiveController --> repo : getScenarioRepository()
activate repo

repo --> BuyLocomotiveController : scenarioRepository
deactivate repo

BuyLocomotiveController --> repo : getLocomotiveRepository()
activate repo

repo --> BuyLocomotiveController : locomotiveRepository
deactivate repo

BuyLocomotiveController --> repo : getBudgetRepository()
activate repo

repo --> BuyLocomotiveController : budgetRepository
deactivate repo

deactivate BuyLocomotiveController

BuyLocomotiveUI --> BuyLocomotiveController : getAvailableLocomotives()
activate BuyLocomotiveController

BuyLocomotiveController --> srepo : getAvailableLocomotives()
activate srepo

srepo --> BuyLocomotiveController : returns available locomotives list
deactivate srepo

BuyLocomotiveController --> lrepo : getLocomotivesByType(availableTypes)
activate lrepo

lrepo --> BuyLocomotiveController : returns List<Locomotive>
deactivate lrepo

BuyLocomotiveController --> DTOMapper : toDTOList(locomotives)
activate DTOMapper

DTOMapper --> BuyLocomotiveController : returns List<LocomotiveDTO>
deactivate DTOMapper

BuyLocomotiveController --> BuyLocomotiveUI : returns List<LocomotiveDTO>
deactivate BuyLocomotiveController

alt available locomotives list is empty
    BuyLocomotiveUI --> Player : outputs "No locomotives available for purchase."
    BuyLocomotiveUI --> BuyLocomotiveUI : return
end

BuyLocomotiveUI --> Player : displays available locomotives
BuyLocomotiveUI --> Player : asks for locomotive selection
deactivate BuyLocomotiveUI

Player -> BuyLocomotiveUI : selects a locomotive
activate BuyLocomotiveUI

loop while locomotive selection is invalid
    BuyLocomotiveUI --> BuyLocomotiveUI : validates locomotive selection
    BuyLocomotiveUI --> Player : outputs "Invalid selection. Try again."
    deactivate BuyLocomotiveUI
    
    Player -> BuyLocomotiveUI : selects a locomotive
    activate BuyLocomotiveUI
end

BuyLocomotiveUI --> BuyLocomotiveUI : validates locomotive selection
BuyLocomotiveUI --> BuyLocomotiveController : purchaseLocomotive(locomotiveDTO)
activate BuyLocomotiveController

BuyLocomotiveController --> brepo : getBudget()
activate brepo

brepo --> BuyLocomotiveController : current budget
deactivate brepo

alt budget < locomotive price
    BuyLocomotiveController --> BuyLocomotiveUI : returns "Error: Not enough budget"
    deactivate BuyLocomotiveController
    BuyLocomotiveUI --> Player : outputs "Error: Not enough budget to purchase this locomotive."
else budget >= locomotive price
    BuyLocomotiveController --> brepo : deductAmount(locomotivePrice)
    activate brepo
    
    brepo --> BuyLocomotiveController : updated budget
    deactivate brepo
    
    BuyLocomotiveController --> lrepo : addLocomotiveToPlayer(locomotiveDTO.getModelName())
    activate lrepo
    
    lrepo --> BuyLocomotiveController : purchased locomotive
    deactivate lrepo
    
    BuyLocomotiveController --> BuyLocomotiveUI : returns purchase success
    deactivate BuyLocomotiveController
    
    BuyLocomotiveUI --> Player : outputs "Success: Locomotive purchased successfully!"
end

deactivate BuyLocomotiveUI

deactivate Player

@enduml