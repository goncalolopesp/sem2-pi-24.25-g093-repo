@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuyLocomotiveUI" as BuyLocomotiveUI

activate Player

Player -> BuyLocomotiveUI : asks to buy a locomotive
activate BuyLocomotiveUI

create ":BuyLocomotiveController" as BuyLocomotiveController

BuyLocomotiveUI --> BuyLocomotiveController : create()

ref over BuyLocomotiveController
    Initialize repositories and get available locomotives
end

BuyLocomotiveUI --> BuyLocomotiveController : getAvailableLocomotives()
activate BuyLocomotiveController

BuyLocomotiveController --> BuyLocomotiveUI : returns List<LocomotiveDTO>
deactivate BuyLocomotiveController

alt available locomotives list is empty
    BuyLocomotiveUI --> Player : outputs "No locomotives available for purchase."
    BuyLocomotiveUI --> BuyLocomotiveUI : return
end

BuyLocomotiveUI --> Player : displays available locomotives
BuyLocomotiveUI --> Player : asks for locomotive selection
deactivate BuyLocomotiveUI

Player -> BuyLocomotiveUI : selects a locomotive
activate BuyLocomotiveUI

loop while locomotive selection is invalid
    BuyLocomotiveUI --> BuyLocomotiveUI : validates locomotive selection
    BuyLocomotiveUI --> Player : outputs "Invalid selection. Try again."
    deactivate BuyLocomotiveUI

    Player -> BuyLocomotiveUI : selects a locomotive
    activate BuyLocomotiveUI
end

BuyLocomotiveUI --> BuyLocomotiveUI : validates locomotive selection

BuyLocomotiveUI --> BuyLocomotiveController : purchaseLocomotive(locomotiveDTO)
activate BuyLocomotiveController

ref over BuyLocomotiveController
    Check budget and purchase locomotive
end

alt budget < locomotive price
    BuyLocomotiveController --> BuyLocomotiveUI : returns "Error: Not enough budget"
    deactivate BuyLocomotiveController
    BuyLocomotiveUI --> Player : outputs "Error: Not enough budget to purchase this locomotive."
else budget >= locomotive price
    BuyLocomotiveController --> BuyLocomotiveUI : returns purchase success
    deactivate BuyLocomotiveController
    BuyLocomotiveUI --> Player : outputs "Success: Locomotive purchased successfully!"
end

deactivate BuyLocomotiveUI
deactivate Player

@enduml