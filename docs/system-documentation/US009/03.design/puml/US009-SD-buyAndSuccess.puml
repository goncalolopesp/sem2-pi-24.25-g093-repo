@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuyLocomotiveUI" as BuyLocomotiveUI
participant ":BuyLocomotiveController" as BuyLocomotiveController
participant "budgetRepository\n:BudgetRepository" as brepo
participant "locomotiveRepository\n:LocomotiveRepository" as lrepo

activate Player
activate BuyLocomotiveUI
activate BuyLocomotiveController

BuyLocomotiveUI --> BuyLocomotiveController : purchaseLocomotive(locomotiveDTO)

BuyLocomotiveController --> brepo : getBudget()
activate brepo
brepo --> BuyLocomotiveController : current budget
deactivate brepo

note right: budget >= locomotive price

BuyLocomotiveController --> brepo : deductAmount(locomotivePrice)
activate brepo
brepo --> BuyLocomotiveController : updated budget
deactivate brepo

BuyLocomotiveController --> lrepo : addLocomotiveToPlayer(locomotiveDTO.getModelName())
activate lrepo
lrepo --> BuyLocomotiveController : purchased locomotive
deactivate lrepo

BuyLocomotiveController --> BuyLocomotiveUI : returns purchase success
deactivate BuyLocomotiveController

BuyLocomotiveUI --> Player : outputs "Success: Locomotive purchased successfully!"

deactivate BuyLocomotiveUI
deactivate Player

@enduml