@startuml US009-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class BuyLocomotiveUI {
  + buyRequest(locomotive: Locomotive)
  + showLocomotives(locomotives: List<Locomotive>)
  + storeBoughtLocomotive(locomotive: Locomotive)
  + showConfirmation()
  + showSuccess(message: String)
}

class BuyLocomotiveController {
  + buyRequest(locomotive: Locomotive)
  + buyLocomotive(locomotive: Locomotive): boolean
}

class LocomotiveRepository {
  + getAvailableLocomotives(): List<Locomotive>
  + buyLocomotive(locomotive: Locomotive) : boolean
}

class ScenarioRepository {
  + getAvailableLocomotives(scenario: Scenario): List<Locomotive>
}

class Locomotive {
  - name: String
  - price: int
  - type : String
  - fuelCost : int
  - maintenanceCost : int
  - startYearOfOperation : int
  - endYearOfOperation : int
  - topSpeed : double
}

class Scenario {
  - scenarioName : String
  - techRestriction : String
  - startYear : int
  - endYear : int
  - historicalRestriction : String
}

BuyLocomotiveUI ..> BuyLocomotiveController     : uses
BuyLocomotiveController ..> LocomotiveRepository   : uses
BuyLocomotiveController ..> ScenarioRepository    : uses

LocomotiveRepository --> Locomotive    : returns
ScenarioRepository  --> Scenario     : returns

@enduml
