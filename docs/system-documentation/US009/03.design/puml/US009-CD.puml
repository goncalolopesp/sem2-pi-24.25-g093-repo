@startuml US009-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'Domains

class CurrentUser{
    - session : CurrentUser
    - usr : Map<String, User>
    + getInstance() : CurrentUser
    + getUser() : User
    + setUSer(User user) : void
    + doLogin(User user) : boolean
    + clear() : void
    + doLogout() : boolean
}

class Budget{
    - budget : int
    - map : Map
    - scenario : Scenario
    - user : User
    + getBudget() : int
    + setBudget(int budget) : void
    + addBudget(int budget) : void
    + subtractBudget(int budget) : void
    + getMap() : Map
    + setMap(Map map) : void
    + getScenario() : Scenario
    + setScenario(Scenario scenario) : void
    + getUser() : User
    + setUser(User user) : void
}

class Locomotive{
    - modelName : String
    - price : int
    - type : String
    - fuelCost : int
    - maintenanceCost : int
    - startYearOfOperation : int
    - endYearOfOperation : int
    - topSpeed : int
    - available : boolean
    + getModelName() : String
    + setModelName(String modelName) : void
    + getPrice() : int
    + setPrice(int price) : void
    + getType() : String
    + setType(String type) : void
    + getFuelCost() : int
    + setFuelCost(int fuelCost) : void
    + getMaintenanceCost() : int
    + setMaintenanceCost(int maintenanceCost) : void
    + getStartYearOfOperation() : int
    + setStartYearOfOperation(int startYearOfOperation) : void
    + getEndYearOfOperation() : int
    + setEndYearOfOperation(int endYearOfOperation) : void
    + getTopSpeed() : int
    + setTopSpeed(int topSpeed) : void
    + getAvailability() : boolean
    + setAvailability(boolean available) : void
}

class Scenario {
    - scenarioName : String
    - selectedMap : String
    - timeRestrictions : int[]
    - technologicalRestrictions : List<String>
    - historicalRestrictions : List<String>
    + getScenarioName(): String
    + getSelectedMap(): String
    + getTimeRestrictions(): int[]
    + getTechnologicalRestrictions(): List<String>
    + getHistoricalRestrictions(): List<String>
    + toString(): String
}

class User {
    - name : String
    - email : String
    - password : String
    - roleId : String
    - locomotives : List<Locomotive>
    + getName(): String
    + getEmail(): String
    + getPassword(): String
    + getRoleId(): String
    + getBudgetValue(): int
    + getLocomotives(): List<Locomotive>
    + setName(): String
    + setEmail(): String
    + setPassword(): String
    + setRoleId(): String
    + setLocomotives(): List<Locomotive>
}

'UI

class BuyLocomotiveUI{
    - scenario : Scenario
    - locomotiveController : BuyLocomotiveController
    + buyLocomotive(String modelName) : boolean
    + listLocomotives() : void
}

class ListLocomotiveUI {

}

'interface
interface Runnable <<interface>>{
    +run(): void
}

'Controllers
class BuyLocomotiveController{
    - locomotiveRepository : LocomotiveRepository
    - session : CurrentUser
    + createLocomotive(String modelName, int price, String type, int fuelCost, int maintenanceCost, int startYearOfOperation, int endYearOfOperation, int topSpeed) : void
    + getLocomotives(Scenario scenario) : List<Locomotive>
    + getPlayerLocomotives() : List<Locomotive>
    + canBuyLocomotive(String modelName, Scenario scenario) : boolean
    + buyLocomotive(String modelName, Scenario scenario) : boolean
}

'Repositories
class Repositories {
    - instance : Repositories
    - locomotiveRepository : LocomotiveRepository
    - budgetRepository : BudgetRepository
    + getInstance() : Repositories
    + getLocomotiveRepository() : LocomotiveRepository
    + getBudgetRepository() : BudgetRepository
}

class LocomotiveRepository{
    - locomotives : Set<Locomotive>
    - session : CurrentUser
    + addLocomotive(Locomotive locomotive) : boolean
    + addLocomotive(String modelName, int price, String type, int fuelCost, int maintenanceCost, int startYearOfOperation, int endYearOfOperation, int topSpeed) : boolean
    + checkIfLocomotiveExists(Locomotive locomotive) : boolean
    + buyLocomotive(Locomotive locomotive) : boolean
    + buyLocomotive(String modelName) : boolean
    + deleteLocomotive(Locomotive locomotive) : boolean
    + getLocomotive(String modelName) : Optional<Locomotive>
    + getLocomotives() : Set<Locomotive>
}

class BudgetRepository{
    - budgets : Set<Budget>
    - session : CurrentUser
    + createBudget(Budget budget) : boolean
    + doesBudgetExist(Budget budget) : boolean
    + getUserBudgetFromScenarioInMap(Scenario scenario, domain.Map map, User user) : Optional<Budget>
}

'Connections

User ..> ListLocomotiveUI
User ..> BuyLocomotiveUI

ListLocomotiveUI ..|> Runnable
BuyLocomotiveUI ..|> Runnable

BuyLocomotiveUI .> BuyLocomotiveController

BuyLocomotiveController ..> LocomotiveRepository : locomotiveRepository

Repositories -> Repositories : instance
Repositories --> "1" LocomotiveRepository

CurrentUser -> CurrentUser : instance

LocomotiveRepository "1" ..> "*" Locomotive
BudgetRepository "1"..>"*" Budget


Budget --> Scenario
Budget --> Map
Budget --> User
CurrentUser --> User : stores session
Locomotive --> User : owned by
Scenario --> User : created by
Locomotive --> Scenario : belongs to

@enduml
