@startuml US009-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'Domains

class CurrentUser{
    - session : CurrentUser
    - usr : Map<String, User>
    + getInstance() : CurrentUser
    + getUser() : User
    + setUser(User user) : void
    + doLogin(User user) : boolean
    + clear() : void
    + doLogout() : boolean
}

class Budget{
    - budget : int
    - map : Map
    - scenario : Scenario
    - user : User
    + getBudget() : int
    + setBudget(int budget) : void
    + addBudget(int budget) : void
    + subtractBudget(int budget) : void
    + deductAmount(int amount) : void
    + getMap() : Map
    + setMap(Map map) : void
    + getScenario() : Scenario
    + setScenario(Scenario scenario) : void
    + getUser() : User
    + setUser(User user) : void
}

class Locomotive{
    - modelName : String
    - price : int
    - type : String
    - fuelCost : int
    - maintenanceCost : int
    - startYearOfOperation : int
    - endYearOfOperation : int
    - topSpeed : int
    - available : boolean
    - owner : User
    + getModelName() : String
    + setModelName(String modelName) : void
    + getPrice() : int
    + setPrice(int price) : void
    + getType() : String
    + setType(String type) : void
    + getFuelCost() : int
    + setFuelCost(int fuelCost) : void
    + getMaintenanceCost() : int
    + setMaintenanceCost(int maintenanceCost) : void
    + getStartYearOfOperation() : int
    + setStartYearOfOperation(int startYearOfOperation) : void
    + getEndYearOfOperation() : int
    + setEndYearOfOperation(int endYearOfOperation) : void
    + getTopSpeed() : int
    + setTopSpeed(int topSpeed) : void
    + getAvailability() : boolean
    + setAvailability(boolean available) : void
    + getOwner() : User
    + setOwner(User owner) : void
}

class Scenario {
    - scenarioName : String
    - selectedMap : String
    - timeRestrictions : int[]
    - technologicalRestrictions : List<String>
    - historicalRestrictions : List<String>
    - availableLocomotives : List<String>
    + getScenarioName() : String
    + getSelectedMap() : String
    + getTimeRestrictions() : int[]
    + getTechnologicalRestrictions() : List<String>
    + getHistoricalRestrictions() : List<String>
    + getAvailableLocomotives() : List<String>
    + setAvailableLocomotives(List<String> locomotives) : void
    + toString() : String
}

class User {
    - name : String
    - email : String
    - password : String
    - roleId : String
    - locomotives : List<Locomotive>
    + getName() : String
    + getEmail() : String
    + getPassword() : String
    + getRoleId() : String
    + getBudgetValue() : int
    + getLocomotives() : List<Locomotive>
    + setName(String name) : void
    + setEmail(String email) : void
    + setPassword(String password) : void
    + setRoleId(String roleId) : void
    + setLocomotives(List<Locomotive> locomotives) : void
    + addLocomotive(Locomotive locomotive) : void
}

'DTOs

class LocomotiveDTO{
    - modelName : String
    - price : int
    - type : String
    - topSpeed : int
    - available : boolean
    + LocomotiveDTO(String modelName, int price, String type, int topSpeed, boolean available)
    + fromEntity(Locomotive locomotive) : LocomotiveDTO
    + getModelName() : String
    + getPrice() : int
    + getType() : String
    + getTopSpeed() : int
    + isAvailable() : boolean
    + toString() : String
}

class DTOMapperLocomotive{
    + toDTO(Locomotive locomotive) : LocomotiveDTO
    + toDTOList(List<Locomotive> locomotives) : List<LocomotiveDTO>
}

'UI

class BuyLocomotiveUI{
    - locomotiveController : BuyLocomotiveController
    + run() : void
    + getAvailableLocomotives() : List<LocomotiveDTO>
    + displayLocomotives(List<LocomotiveDTO> locomotives) : void
    + validateLocomotiveSelection(String selection) : boolean
    + purchaseLocomotive(LocomotiveDTO locomotive) : boolean
}

'Interface
interface Runnable <<interface>>{
    + run() : void
}

'Controllers
class BuyLocomotiveController{
    - locomotiveRepository : LocomotiveRepository
    - scenarioRepository : ScenarioRepository
    - budgetRepository : BudgetRepository
    - repositories : Repositories
    + getAvailableLocomotives() : List<LocomotiveDTO>
    + purchaseLocomotive(LocomotiveDTO locomotive) : boolean
    + validatePurchase(LocomotiveDTO locomotive, int budget) : boolean
    + getLocomotivesByType(List<String> types) : List<LocomotiveDTO>
}

'Repositories
class Repositories {
    - instance : Repositories
    - locomotiveRepository : LocomotiveRepository
    - budgetRepository : BudgetRepository
    - scenarioRepository : ScenarioRepository
    + getInstance() : Repositories
    + getLocomotiveRepository() : LocomotiveRepository
    + getBudgetRepository() : BudgetRepository
    + getScenarioRepository() : ScenarioRepository
}

class LocomotiveRepository{
    - locomotives : Set<Locomotive>
    + addLocomotive(Locomotive locomotive) : boolean
    + addLocomotiveToPlayer(String modelName) : boolean
    + checkIfLocomotiveExists(Locomotive locomotive) : boolean
    + getLocomotive(String modelName) : Optional<Locomotive>
    + getLocomotives() : Set<Locomotive>
    + getLocomotivesByType(List<String> types) : List<Locomotive>
    + getPrice(String modelName) : int
    + deleteLocomotive(Locomotive locomotive) : boolean
}

class BudgetRepository{
    - budgets : Set<Budget>
    + createBudget(Budget budget) : boolean
    + doesBudgetExist(Budget budget) : boolean
    + getBudget() : int
    + getUserBudgetFromScenarioInMap(Scenario scenario, Map map, User user) : Optional<Budget>
    + deductAmount(int amount) : void
}

class ScenarioRepository{
    - scenarios : Set<Scenario>
    + addScenario(Scenario scenario) : boolean
    + getScenario(String name) : Optional<Scenario>
    + getScenarios() : Set<Scenario>
    + getAvailableLocomotives() : List<String>
}

'Connections

User ..> BuyLocomotiveUI

BuyLocomotiveUI ..|> Runnable

BuyLocomotiveUI --> BuyLocomotiveController
BuyLocomotiveUI ..> LocomotiveDTO

BuyLocomotiveController --> Repositories
BuyLocomotiveController ..> LocomotiveRepository
BuyLocomotiveController ..> BudgetRepository
BuyLocomotiveController ..> ScenarioRepository
BuyLocomotiveController ..> LocomotiveDTO
BuyLocomotiveController ..> DTOMapperLocomotive

DTOMapperLocomotive ..> Locomotive : converts
DTOMapperLocomotive ..> LocomotiveDTO : creates

Repositories -> Repositories : instance
Repositories --> "1" LocomotiveRepository
Repositories --> "1" BudgetRepository
Repositories --> "1" ScenarioRepository

CurrentUser -> CurrentUser : instance
CurrentUser --> User : stores session

LocomotiveRepository "1" ..> "*" Locomotive
BudgetRepository "1" ..> "*" Budget
ScenarioRepository "1" ..> "*" Scenario

Budget --> Scenario
Budget --> User
Locomotive --> User
Scenario --> User

@enduml