@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


skinparam classAttributeIconSize 0

hide circle
hide methods

class Train{
    locomotives
    carriages
    cargoType
}

class Locomotive{
    typeOfFuel
    locomotiveType
}

class SteamLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class DieselLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class ElectricLocomotive{
    requiredRail
    price
    startYearOfOperation
    power
    acceleration
    topSpeed
}

class Carriage{
    typeOfCargo
}

class Player {
    username
    password
    + buyTrain(carriage: Carriage, locomotive: Locomotive)
}

Player *-- Train
Train *-- Locomotive
Train o-- Carriage
SteamLocomotive --|> Locomotive
DieselLocomotive --|> Locomotive
ElectricLocomotive --|> Locomotive

@enduml