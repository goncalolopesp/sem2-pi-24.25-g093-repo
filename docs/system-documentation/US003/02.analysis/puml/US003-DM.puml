@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    +name: String
    +sizeX: int
    +sizeY: int
    +cities: List<City>
    +industries: List<Industry>
  }

  class City {
    +name: String
    +positionX: int
    +positionY: int
    +numHouseBlocks: int
  }

  class Industry {
    +type: String
    +positionX: int
    +positionY: int
  }

  Map "1" o-- "*" City : contains
  Map "1" o-- "*" Industry : contains
}
@enduml