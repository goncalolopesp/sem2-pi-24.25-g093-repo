<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: #1E1E2F;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BuildStationController">
    <children>
        <VBox alignment="CENTER" layoutX="50.0" layoutY="30.0" prefHeight="540.0" prefWidth="400.0" spacing="20.0">
            <children>
                <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="BUILD STATION" textAlignment="CENTER">
                    <font>
                        <Font name="Arial Bold" size="36.0" />
                    </font>
                </Text>

                <Label fx:id="budgetLabel" text="Current Budget: $0" textFill="WHITE">
                    <font>
                        <Font name="Arial" size="14.0" />
                    </font>
                </Label>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Station Type:" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="stationTypeComboBox" onAction="#onStationTypeChanged" prefWidth="200.0" promptText="Select station type" />
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="10.0">
                            <children>
                                <Label text="X Coordinate:" textFill="WHITE">
                                    <font>
                                        <Font name="Arial" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="xCoordinateField" prefWidth="100.0" promptText="Enter X" />
                            </children>
                        </VBox>
                        <VBox spacing="10.0">
                            <children>
                                <Label text="Y Coordinate:" textFill="WHITE">
                                    <font>
                                        <Font name="Arial" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="yCoordinateField" prefWidth="100.0" promptText="Enter Y" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox fx:id="orientationBox" spacing="10.0" visible="false">
                    <children>
                        <Label text="Orientation (for STATION only):" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="orientationComboBox" prefWidth="200.0" promptText="Select orientation" />
                    </children>
                </VBox>

                <Label fx:id="costLabel" text="Cost: $0" textFill="#FFD700">
                    <font>
                        <Font name="Arial Bold" size="16.0" />
                    </font>
                </Label>

                <Label fx:id="capacityLabel" text="Capacity: 0" textFill="#90EE90">
                    <font>
                        <Font name="Arial" size="14.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="buildButton" onAction="#handleBuildStation" prefHeight="40.0" prefWidth="120.0" text="BUILD STATION">
                            <font>
                                <Font name="Arial" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="cancelButton" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" text="CANCEL">
                            <font>
                                <Font name="Arial" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Label fx:id="messageLabel" text="" textFill="#FF6B6B" wrapText="true">
                    <font>
                        <Font name="Arial" size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </children>
</AnchorPane>