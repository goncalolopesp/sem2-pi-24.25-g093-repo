<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="600.0" style="-fx-background-color: #1E1E2F;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AssignTrainGUIController">
    <children>
        <ScrollPane fitToWidth="true" layoutX="25.0" layoutY="25.0" prefHeight="650.0" prefWidth="550.0" style="-fx-background: #1E1E2F; -fx-background-color: #1E1E2F;">
            <content>
                <VBox alignment="CENTER" prefWidth="530.0" spacing="20.0" style="-fx-padding: 20;">
                    <children>
                        <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="ASSIGN TRAIN TO ROUTE" textAlignment="CENTER">
                            <font>
                                <Font name="Arial Bold" size="32.0" />
                            </font>
                        </Text>

                        <Label fx:id="budgetLabel" text="Current Budget: $0" textFill="WHITE">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </Label>

                        <Label fx:id="messageLabel" text="" textFill="#FF6B6B" wrapText="true" visible="false">
                            <font>
                                <Font name="Arial" size="12.0" />
                            </font>
                        </Label>

                        <VBox spacing="10.0" style="-fx-border-color: #444; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15;">
                            <children>
                                <Label text="Select Train:" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                </Label>

                                <ListView fx:id="trainListView" prefHeight="150.0" style="-fx-background-color: #2A2A3E; -fx-border-color: #444;">
                                </ListView>
                            </children>
                        </VBox>

                        <VBox fx:id="routeSection" spacing="15.0" style="-fx-border-color: #444; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15;" visible="false">
                            <children>
                                <Label text="Create Route:" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="16.0" />
                                    </font>
                                </Label>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Current Route Points:" textFill="WHITE">
                                            <font>
                                                <Font name="Arial" size="14.0" />
                                            </font>
                                        </Label>
                                        <ListView fx:id="routeListView" prefHeight="100.0" style="-fx-background-color: #2A2A3E; -fx-border-color: #444;">
                                        </ListView>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Add Station to Route:" textFill="WHITE">
                                            <font>
                                                <Font name="Arial" size="14.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="stationComboBox" prefWidth="400.0" promptText="Select a station to add" style="-fx-background-color: #2A2A3E; -fx-text-fill: white; -fx-border-color: #444;">
                                        </ComboBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="cargoSelectionBox" spacing="10.0" visible="false">
                                    <children>
                                        <Label text="Select Cargo Types for this Station:" textFill="WHITE">
                                            <font>
                                                <Font name="Arial" size="14.0" />
                                            </font>
                                        </Label>

                                        <VBox fx:id="cargoCheckBoxContainer" spacing="5.0">
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="cargoModeBox" spacing="10.0" visible="false">
                                    <children>
                                        <Label text="Select Cargo Mode:" textFill="WHITE">
                                            <font>
                                                <Font name="Arial" size="14.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="cargoModeComboBox" prefWidth="300.0" style="-fx-background-color: #2A2A3E; -fx-text-fill: white; -fx-border-color: #444;">
                                        </ComboBox>
                                    </children>
                                </VBox>

                                <Button fx:id="addStationButton" onAction="#handleAddStation" prefHeight="35.0" prefWidth="150.0" text="ADD STATION" visible="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button fx:id="assignButton" onAction="#handleAssignTrain" prefHeight="40.0" prefWidth="120.0" text="ASSIGN TRAIN" visible="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Button>
                                <Button fx:id="clearRouteButton" onAction="#handleClearRoute" prefHeight="40.0" prefWidth="120.0" text="CLEAR ROUTE" visible="false">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Button>
                                <Button fx:id="cancelButton" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" text="CANCEL" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>