<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane fx:id="BuyLocomotive" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #1E1E2F;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BuyLocomotiveController">
   <children>
      <Button layoutX="201.0" layoutY="314.0" mnemonicParsing="false" onAction="#buySelectedLocomotive" prefHeight="59.0" prefWidth="91.0" text="Buy" textAlignment="CENTER" wrapText="true" />
      <ComboBox fx:id="locomotiveList_cmb" layoutX="225.0" layoutY="52.0" onAction="#listLocomotiveDetails" opacity="0.75" prefWidth="150.0" />
      <Label layoutX="221.0" layoutY="15.0" text="Buy A Locomotive" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>
      <TextArea fx:id="locomotiveDetails_TxtA" editable="false" layoutX="201.0" layoutY="100.0" opacity="0.5" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
      <Button layoutX="310.0" layoutY="314.0" mnemonicParsing="false" onAction="#returnToMenu" prefHeight="59.0" prefWidth="91.0" style="-fx-background-color: red;" text="Back" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Label fx:id="budgetLabel" layoutX="528.0" layoutY="31.0" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
