<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ListStations" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #1E1E2F;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListStationController">
   <children>
      <Label contentDisplay="CENTER" layoutX="239.0" layoutY="42.0" prefHeight="60.0" prefWidth="123.0" style="-fx-text-fill: white;" text="My Stations" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <ComboBox fx:id="StationList" layoutX="225.0" layoutY="128.0" onAction="#ShowStationDescription" prefWidth="150.0" />
      <TextArea fx:id="StationDescription" editable="false" layoutX="200.0" layoutY="188.0" prefHeight="200.0" prefWidth="200.0" />
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#returnToMenu" style="-fx-background-color: red;" text="Back" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
