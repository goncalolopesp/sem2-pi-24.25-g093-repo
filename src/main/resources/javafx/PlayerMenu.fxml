<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="PlayerMenu" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PlayerMenuController">
   <children>
      <Button contentDisplay="CENTER" layoutX="200.0" layoutY="68.0" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" text="Upgrade Station Type" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="75.0" layoutY="68.0" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" text="Build A Station" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="325.0" layoutY="68.0" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" text="Upgrade Station Building" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="75.0" layoutY="248.0" mnemonicParsing="false" onAction="#BuyLocomotive" prefHeight="80.0" prefWidth="80.0" text="Buy a Locomotive" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="200.0" layoutY="248.0" mnemonicParsing="false" onAction="#ListLocomotives" prefHeight="80.0" prefWidth="80.0" text="List Locomotives" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="11.0" />
         </font></Button>
      <Button layoutX="450.0" layoutY="68.0" mnemonicParsing="false" onAction="#ListStations" prefHeight="80.0" prefWidth="80.0" text="List My Stations" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="325.0" layoutY="248.0" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" text="Assign Train to Route" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="450.0" layoutY="248.0" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" text="Pause" textAlignment="CENTER" wrapText="true" />
      <Button layoutX="523.0" layoutY="353.0" mnemonicParsing="false" onAction="#doLogout" style="-fx-background-color: red;" text="Logout" textAlignment="CENTER" textFill="WHITE" />
   </children>
</AnchorPane>
