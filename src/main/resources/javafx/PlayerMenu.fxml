<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="PlayerMenu" prefHeight="850.0" prefWidth="1065.0" style="-fx-background-color: #1E1E2F;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PlayerMenuController">
   <children>
      <Button fx:id="upgradeStationTypeBtn" contentDisplay="CENTER" layoutX="920.0" layoutY="191.0" mnemonicParsing="false" onAction="#handleUpgradeStationType" prefHeight="80.0" prefWidth="95.0" text="UPGRADE STATION TYPE" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="buildStationBtn" layoutX="800.0" layoutY="191.0" mnemonicParsing="false" onAction="#handleBuildStation" prefHeight="80.0" prefWidth="95.0" text="BUILD A STATION" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="upgradeStationBuildingBtn" layoutX="800.0" layoutY="291.0" mnemonicParsing="false" onAction="#handleUpgradeStationBuilding" prefHeight="80.0" prefWidth="95.0" text="UPGRADE STATION BUILDING" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="buyLocomotiveBtn" layoutX="800.0" layoutY="391.0" mnemonicParsing="false" onAction="#BuyLocomotive" prefHeight="80.0" prefWidth="95.0" text="BUY A LOCOMOTIVE" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="listLocomotivesBtn" layoutX="920.0" layoutY="391.0" mnemonicParsing="false" onAction="#ListLocomotives" prefHeight="80.0" prefWidth="95.0" text="LIST LOCOMOTIVES" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="11.0" />
         </font></Button>
      <Button fx:id="listStationsBtn" layoutX="920.0" layoutY="291.0" mnemonicParsing="false" onAction="#ListStations" prefHeight="80.0" prefWidth="95.0" text="LIST MY STATIONS" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="assignTrainBtn" layoutX="800.0" layoutY="491.0" mnemonicParsing="false" onAction="#handleAssignTrain" prefHeight="80.0" prefWidth="95.0" text="ASSIGN TRAIN TO ROUTE" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="pauseBtn" layoutX="920.0" layoutY="491.0" mnemonicParsing="false" onAction="#handlePause" prefHeight="80.0" prefWidth="95.0" text="PAUSE" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="resumeBtn" layoutX="920.0" layoutY="491.0" mnemonicParsing="false" onAction="#handleResume" prefHeight="80.0" prefWidth="95.0" text="RESUME" textAlignment="CENTER" visible="false" wrapText="true" />
      <Button fx:id="backBtn" layoutX="997.0" layoutY="738.0" mnemonicParsing="false" onAction="#doLogout" style="-fx-background-color: red;" text="BACK" textAlignment="CENTER" textFill="WHITE" />

      <!-- Map Display Area - Moved up to center vertically -->
      <ScrollPane layoutX="50.0" layoutY="75.0" prefHeight="500.0" prefWidth="700.0"
                  style="-fx-background: #2A2A3A; -fx-border-color: #444; -fx-border-width: 2;"
                  fitToWidth="true" fitToHeight="true">
         <content>
            <GridPane fx:id="mapGridPane"
                      style="-fx-background-color: #2A2A3A;"
                      alignment="CENTER" />
         </content>
      </ScrollPane>

      <!-- Year Display -->
      <Text fx:id="yearText" fill="WHITE" layoutX="125.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Year: Loading..." textAlignment="LEFT">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Text>

      <!-- Budget Display -->
      <Text fx:id="budgetText" fill="WHITE" layoutX="600.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Budget: Loading..." textAlignment="RIGHT">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Text>

      <!-- Map Legend -->
      <AnchorPane layoutX="50.0" layoutY="595.0" prefHeight="150.0" prefWidth="700.0"
                  style="-fx-background-color: #2A2A3A; -fx-border-color: #444; -fx-border-width: 1;">
         <children>
            <Text fill="WHITE" layoutX="10.0" layoutY="20.0" text="Map Legend:" textAlignment="LEFT">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
            </Text>
            <Text fill="ORANGE" layoutX="10.0" layoutY="40.0" text="■ Industries" textAlignment="LEFT" />
            <Text fill="LIGHTBLUE" layoutX="10.0" layoutY="60.0" text="■ City Centers" textAlignment="LEFT" />
            <Text fill="LIGHTGREEN" layoutX="10.0" layoutY="80.0" text="■ City Blocks" textAlignment="LEFT" />
            <Text fill="YELLOW" layoutX="120.0" layoutY="40.0" text="■ Stations" textAlignment="LEFT" />
            <Text fill="LIGHTYELLOW" layoutX="120.0" layoutY="60.0" text="■ Station Areas" textAlignment="LEFT" />
            <Text fill="DARKGRAY" layoutX="120.0" layoutY="80.0" text="■ Empty Space" textAlignment="LEFT" />
         </children>
      </AnchorPane>

      <!-- Remove the old map text -->
      <!-- <Text fx:id="mapText" ... /> -->

   </children>
</AnchorPane>